@bot.message_handler(
    commands=["notfound"]
)
def not_found_cmd(message):

    if message.from_user.id != ADMIN_ID:
        return

    text = get_not_found()

    # Telegram ограничивает сообщение примерно 4096 символами.
    # Поэтому делим длинный отчёт.
    chunks = []

    while len(text) > 4000:

        position = text.rfind(
            "\n",
            0,
            4000
        )

        if position == -1:
            position = 4000

        chunks.append(
            text[:position]
        )

        text = text[position:]

    if text:
        chunks.append(text)

    for chunk in chunks:

        bot.send_message(
            message.chat.id,
            chunk
        )


