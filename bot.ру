# CACHE CLEANUP WORKER
# ============================================================

def cache_cleanup_worker():

    while True:

        try:

            time.sleep(
                6 * 60 * 60
            )

            clear_old_photo_cache()

        except Exception as e:

            print(
                f"[CACHE CLEANUP] {e}"
            )


# ============================================================
# POLLING
# ============================================================

def polling_error_handler():

    while True:

        try:

            print(
                "🚀 Запуск Telegram polling..."
            )

            bot.infinity_polling(
                timeout=30,
                long_polling_timeout=30,
                skip_pending=True
            )

        except KeyboardInterrupt:

            print(
                "🛑 Остановка бота."
            )

            break

        except Exception as e:

            print(
                "=" * 70
            )

            print(
                "❌ POLLING ERROR:"
            )

            print(
                repr(e)
            )

            print(
                "=" * 70
            )

            print(
                "⏳ Перезапуск через 5 секунд..."
            )

            time.sleep(
                5
            )


