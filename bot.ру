def perform_search(
    chat_id,
    query
):

    query = safe_text(
        query
    )

    if len(query) < 2:

        bot.send_message(
            chat_id,
            "⚠️ Введите минимум 2 символа."
        )

        return

    mode = current_mode.get(
        chat_id
    )

    # --------------------------------------------------------
    # WEB SEARCH
    # --------------------------------------------------------

    if mode == "web":

        print(
            f"🌐 WEB SEARCH: {query}"
        )
    
        log_search(
            chat_id,
            query,
            "web"
        )
    
        show_loading_message(
            chat_id,
            "⏳ Пожалуйста, подождите...\n"
            "🧠 Анализируем запрос и ищем информацию..."
        )
    
        try:
    
            search_query = improve_web_query(
                query
            )
    
            print(
                f"[WEB SEARCH] Original: "
                f"{query}"
            )
    
            print(
                f"[WEB SEARCH] Improved: "
                f"{search_query}"
            )
    
            # ----------------------------------------------------
            # Сначала настоящий AI Web Search.
            # ----------------------------------------------------
    
            results = []
    
            if AI_WEB_ENABLED:
    
                results = ai_web_search(
                    query,
                    search_query,
                    max_results=WEB_MAX_RESULTS
                )
    
            # ----------------------------------------------------
            # Fallback:
            # если AI недоступен или произошла ошибка,
            # используем твой старый web_search().
            # ----------------------------------------------------
    
            if not results:
    
                print(
                    "⚠️ AI WEB unavailable. "
                    "Using legacy web search."
                )
    
                results = web_search(
                    search_query,
                    max_results=WEB_MAX_RESULTS
                )
    
        except Exception as e:
    
            print(
                f"[WEB SEARCH] Error: "
                f"{repr(e)}"
            )
    
            # ----------------------------------------------------
            # Последняя попытка — старый поиск.
            # ----------------------------------------------------
    
            try:
    
                results = web_search(
                    query,
                    max_results=WEB_MAX_RESULTS
                )
    
            except Exception as fallback_error:
    
                print(
                    f"[WEB SEARCH FALLBACK] "
                    f"{repr(fallback_error)}"
                )
    
                results = []
    
        hide_loading_message(
            chat_id
        )
    
        if not results:
    
            log_search(
                chat_id,
                query,
                "NOT_FOUND_WEB"
            )
    
            bot.send_message(
                chat_id,
                "❌ В интернете ничего "
                "подходящего не найдено.\n\n"
                "Попробуйте изменить запрос."
            )
    
            return
    
        web_results[
            chat_id
        ] = results
    
        web_index[
            chat_id
        ] = 0
    
        web_query[
            chat_id
        ] = query
    
        send_web_card(
            chat_id,
            0
        )
    
        return

    # --------------------------------------------------------
    # PARTS
    # --------------------------------------------------------

    if mode == "parts":

        print(
            f"🔥 SEARCH PARTS: {query}"
        )

        log_search(
            chat_id,
            query,
            "parts"
        )

        results = find_part(
            query
        )

        if not results:

            print(
                f"❌ NOT FOUND PARTS: "
                f"{query}"
            )

            log_search(
                chat_id,
                query,
                "NOT_FOUND"
            )

            bot.send_message(
                chat_id,
                "❌ Ничего не найдено.\n\n"
                "Проверьте номер детали."
            )

            return

        user_results[
            chat_id
        ] = results

        user_index[
            chat_id
        ] = 0

        user_photo_index[
            chat_id
        ] = 0

        send_part_card(
            chat_id,
            0
        )

        return

    # --------------------------------------------------------
    # WHEELS
    # --------------------------------------------------------

    if mode == "wheels":
    
        print(
            f"🔥 SEARCH WHEELS: {query}"
        )
    
        log_search(
            chat_id,
            query,
            "wheels"
        )
    
        # --------------------------------------------------------
        # Показываем загрузку ДО поиска и загрузки фотографий.
        # --------------------------------------------------------
    
        show_loading_message(
            chat_id,
            "⏳ Пожалуйста, подождите...\n"
            "🛞 Ищем подходящие шины и диски..."
        )
    
        try:
    
            results = find_wheels(
                query
            )
    
        except Exception as e:
    
            print(
                f"[SEARCH WHEELS] Error: {e}"
            )
    
            hide_loading_message(
                chat_id
            )
    
            bot.send_message(
                chat_id,
                "❌ Произошла ошибка при поиске."
            )
    
            return
    
        if not results:
    
            hide_loading_message(
                chat_id
            )
    
            print(
                f"❌ NOT FOUND WHEELS: "
                f"{query}"
            )
    
            log_search(
                chat_id,
                query,
                "NOT_FOUND_WHEELS"
            )
    
            bot.send_message(
                chat_id,
                "❌ Ничего не найдено."
            )
    
            return
    
        user_results[
            chat_id
        ] = results
    
        user_index[
            chat_id
        ] = 0
    
        user_photo_index[
            chat_id
        ] = 0
    
        # --------------------------------------------------------
