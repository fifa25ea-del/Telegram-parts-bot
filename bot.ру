@bot.callback_query_handler(
    func=lambda call:
        call.data.startswith(
            "fav_"
        )
)
def callback_favorite(
    call
):

    # ВАЖНО:
    # отвечаем сразу.
    safe_callback_answer(
        call
    )

    chat_id = (
        call.message.chat.id
    )

    try:

        index = int(
            call.data.split(
                "_",
                1
            )[1]
        )

    except Exception:

        return

    results = user_results.get(
        chat_id,
        []
    )

    if (
        index < 0
        or index >= len(results)
    ):

        return

    item = results[index]

    if is_favorite(
        chat_id,
        item
    ):

        item_id = get_item_id(
            item
        )

        remove_favorite(
            chat_id,
            item_id
        )

        # Второй ответ может уже быть
        # просроченным — функция безопасная.
        safe_callback_answer(
            call,
            "💔 Удалено из избранного"
        )

    else:

        add_favorite(
            chat_id,
            item
        )

        safe_callback_answer(
            call,
            "❤️ Добавлено в избранное"
        )

    mode = current_mode.get(
        chat_id
    )

    if mode == "parts":

        send_part_card(
            chat_id,
            index
        )

    elif mode == "wheels":

        send_wheel_card(
            chat_id,
            index
        )


