def safe_text(value):
    if value is None:
        return ""

    return str(value).strip()


def normalize(text):
    """
    Нормализация для поиска.
    """

    text = safe_text(text).lower()

    # Кириллическая а -> латинская a
    text = text.replace("а", "a")

    # Ё -> е
    text = text.replace("ё", "е")

    # Убираем разделители
    text = re.sub(
        r"[\s\-_./\\]+",
        "",
        text
    )

    return text


def normalize_article(text):
    """
    Более агрессивная нормализация артикула.
    """

    text = normalize(text)

    # Иногда артикулы содержат пробелы / двоеточия / скобки
    text = re.sub(
        r"[^a-z0-9а-я]",
        "",
        text
    )

    return text


def first_photo(value):
    if not value:
        return None

    for photo in str(value).split(","):

        photo = photo.strip()

        if photo.startswith("http://"):
            return photo

        if photo.startswith("https://"):
            return photo

    return None


def photo_list(value):
    if not value:
        return []

    result = []

    for photo in str(value).split(","):

        photo = photo.strip()

        if not photo:
            continue

        if not (
            photo.startswith("http://")
            or photo.startswith("https://")
        ):
            continue

        if photo not in result:
            result.append(photo)

    return result[:MAX_PHOTOS]


