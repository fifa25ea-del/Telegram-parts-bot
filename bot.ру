    while True:

        try:

            time.sleep(
                CSV_REFRESH_SECONDS
            )

            print("=" * 70)
            print(
                "🔄 АВТООБНОВЛЕНИЕ CSV"
            )
            print("=" * 70)

            load_database()

            print(
                "✅ CSV обновлены"
            )

        except Exception as e:

            print(
                f"[CSV REFRESH] Ошибка: {e}"
            )

            # Продолжаем работу.
            time.sleep(30)


def start_database_refresh():

    thread = threading.Thread(
        target=database_refresh_loop,
        daemon=True,
        name="CSV-Refresh"
    )

    thread.start()

    print(
        "🔄 Автообновление CSV "
        "запущено."
    )


