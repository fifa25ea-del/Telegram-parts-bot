def build_parts_index():

    global parts_index

    new_index = defaultdict(list)

    for position, part in enumerate(parts_db):

        values = []

        # ИЩЕМ ТОЛЬКО ЗДЕСЬ
        if cross_numbers_key:
            values.append(
                part.get(
                    cross_numbers_key,
                    ""
                )
            )

        if manufacturer_number_key:
            values.append(
                part.get(
                    manufacturer_number_key,
                    ""
                )
            )

        for value in values:

            value = safe_text(value)

            if not value:
                continue

            # В одной ячейке может быть несколько
            # кросс-номеров.
            #
            # Например:
            # A1633500514, A1633500614
            # A1633500514 / A1633500714
            #
            # Разделяем их.

            numbers = re.split(
                r"[,;/|\n]+",
                value
            )

            for number in numbers:

                number = normalize(
                    fix_a(number)
                )

                if not number:
                    continue

                # Полный номер
                new_index[
                    number
                ].append(position)

                # Префиксы для ускорения поиска
                if len(number) >= 4:

                    for length in (
                        4,
                        5,
                        6,
                        7,
                        8
                    ):

                        if len(number) >= length:

                            new_index[
                                number[:length]
                            ].append(
                                position
                            )

    parts_index = new_index

    print(
        f"[INDEX] Parts index: "
        f"{len(parts_index)} keys"
    )

