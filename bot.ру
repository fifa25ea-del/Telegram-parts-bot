def find_part(
    query,
    db=None
):

    query = normalize(
        fix_a(query)
    )

    if not query:
        return []

    with database_lock:

        database = (
            parts_db
            if db is None
            else db
        )

        # ====================================================
        # Сначала используем индекс
        # ====================================================

        positions = []

        if query in parts_index:

            positions = parts_index[
                query
            ]

        elif len(query) >= 4:

            prefix = query[:4]

            positions = parts_index.get(
                prefix,
                []
            )

        # ====================================================
        # Проверяем найденные позиции
        # ====================================================

        if positions:

            unique_positions = []

            seen = set()

            for position in positions:

                if position in seen:
                    continue

                seen.add(position)

                unique_positions.append(
                    position
                )

                if (
                    len(unique_positions)
                    >= MAX_RESULTS
                ):
                    break

            results = []

            for position in unique_positions:

                if position >= len(database):
                    continue

                part = database[position]

                values = []

                if cross_numbers_key:

                    values.append(
                        part.get(
                            cross_numbers_key,
                            ""
                        )
                    )

                if manufacturer_number_key:

                    values.append(
                        part.get(
                            manufacturer_number_key,
                            ""
                        )
                    )

                found = False

                for value in values:

                    value = safe_text(
                        value
                    )

                    if not value:
                        continue

                    numbers = re.split(
                        r"[,;/|\n]+",
                        value
                    )

                    for number in numbers:

                        number = normalize(
                            fix_a(number)
                        )

                        if (
                            query
                            in number
                        ):

                            found = True
                            break

                    if found:
                        break

                if found:

                    results.append(
                        part
                    )

            return results[
                :MAX_RESULTS
            ]

        # ====================================================
        # Fallback — прямой поиск
        # ====================================================

        results = []

        for part in database:

            values = []

            if cross_numbers_key:

                values.append(
                    part.get(
                        cross_numbers_key,
                        ""
                    )
                )

            if manufacturer_number_key:

                values.append(
                    part.get(
                        manufacturer_number_key,
                        ""
                    )
                )

            found = False

            for value in values:

                value = safe_text(
                    value
                )

                if not value:
                    continue

                numbers = re.split(
                    r"[,;/|\n]+",
                    value
                )

                for number in numbers:

                    number = normalize(
                        fix_a(number)
                    )

                    if (
                        query
                        in number
                    ):

                        found = True
                        break

                if found:
                    break

            if found:

                results.append(
                    part
                )

            if (
                len(results)
                >= MAX_RESULTS
            ):
                break

        return results

