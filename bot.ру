def build_parts_index():

    global parts_index

    new_index = defaultdict(
        list
    )

    for position, part in enumerate(
        parts_db
    ):

        values = []

        if number_key:

            values.append(
                part.get(
                    number_key,
                    ""
                )
            )

        values.extend([
            part.get(
                "Артикул",
                ""
            ),
            part.get(
                "Номер",
                ""
            )
        ])

        for value in values:

            value = normalize(
                fix_a(value)
            )

            if not value:
                continue

            new_index[
                value
            ].append(
                position
            )

            if len(value) >= 4:

                for length in (
                    4,
                    5,
                    6,
                    7,
                    8
                ):

                    if len(value) >= length:

                        new_index[
                            value[:length]
                        ].append(
                            position
                        )

    parts_index = new_index

    print(
        f"[INDEX] Parts: "
        f"{len(parts_index)} keys"
    )


