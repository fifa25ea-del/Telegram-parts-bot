)
def show_all_photos(call):

    # Сначала отвечаем Telegram
    try:
        bot.answer_callback_query(
            call.id
        )
    except Exception:
        pass

    chat_id = call.message.chat.id

    try:

        index = int(
            call.data.split("_")[1]
        )

    except Exception:

        return

    results = user_results.get(
        chat_id,
        []
    )

    if (
        not results
        or index < 0
        or index >= len(results)
    ):
        return

    part = results[index]

    photos = str(
        part.get(
            "Фото",
            ""
        )
    )

    photo_list = [
        x.strip()
        for x in photos.split(",")
        if x.strip().startswith("http")
    ]

    if not photo_list:

        bot.send_message(
            chat_id,
            "❌ Фото не найдены"
        )

        return

    media = []

    for url in photo_list[:10]:

        media.append(
            telebot.types.InputMediaPhoto(
                url
            )
        )

    try:

        sent_msgs = bot.send_media_group(
            chat_id,
            media
        )

        user_album_msgs[
            chat_id
        ] = [
            m.message_id
            for m in sent_msgs
        ]

    except Exception as e:

        print(
            "⚠️ Telegram не смог "
            "загрузить альбом:",
            e
        )

        # Fallback:
        # скачиваем проблемные фото
        # и отправляем из файлов.

        media = []

        temp_files = []

        for url in photo_list[:10]:

            cache_path = (
                download_photo_to_cache(
                    url
                )
            )

            if not cache_path:
                continue

            temp_files.append(
                cache_path
            )

        opened_files = []

        try:

            for path in temp_files:

                f = open(
                    path,
                    "rb"
                )

                opened_files.append(f)

                media.append(
                    telebot.types.InputMediaPhoto(
                        f
                    )
                )

            if media:

                sent_msgs = bot.send_media_group(
                    chat_id,
                    media
                )

                user_album_msgs[
                    chat_id
                ] = [
                    m.message_id
                    for m in sent_msgs
                ]

        except Exception as e:

            print(
                "❌ Ошибка fallback "
                "альбома:",
                e
            )

        finally:

            for f in opened_files:

                try:
                    f.close()
                except Exception:
                    pass


    kb = telebot.types.InlineKeyboardMarkup()

    kb.add(
        telebot.types.InlineKeyboardButton(
            "⬅️ Назад к товару",
            callback_data=f"back_{index}"
        )
    )

    bot.send_message(
        chat_id,
        "⬅️ Вернуться к товару",
        reply_markup=kb
    )


