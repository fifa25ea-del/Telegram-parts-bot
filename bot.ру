def find_part(query, db=None):

    query = normalize(query)

    if not query:
        return []

    results = []

    with db_lock:

        # ====================================================
        # 1. ТОЧНЫЙ АРТИКУЛ
        # ====================================================

        exact = article_index.get(
            query,
            []
        )

        if exact:

            return exact[:20]


        # ====================================================
        # 2. ТОЧНЫЙ НОМЕР
        # ====================================================

        exact = number_index.get(
            query,
            []
        )

        if exact:

            return exact[:20]


        # ====================================================
        # 3. НАЧАЛО АРТИКУЛА
        # ====================================================

        for key, items in article_index.items():

            if key.startswith(query):

                results.extend(items)

                if len(results) >= 20:

                    return results[:20]


        # ====================================================
        # 4. НАЧАЛО НОМЕРА
        # ====================================================

        for key, items in number_index.items():

            if key.startswith(query):

                results.extend(items)

                if len(results) >= 20:

                    return results[:20]


        # ====================================================
        # 5. ЧАСТЬ АРТИКУЛА
        # ====================================================

        for key, items in article_index.items():

            if query in key:

                results.extend(items)

                if len(results) >= 20:

                    return results[:20]


        # ====================================================
        # 6. ЧАСТЬ НОМЕРА
        # ====================================================

        for key, items in number_index.items():

            if query in key:

                results.extend(items)

                if len(results) >= 20:

                    return results[:20]


    return results[:20]


