def bytes_to_file(
    content,
    filename="photo.jpg"
):
    """
    Telegram/pyTelegramBotAPI лучше получает
    фотографии как BytesIO с именем файла.
    """

    file_obj = io.BytesIO(
        content
    )

    file_obj.name = filename

    file_obj.seek(0)

    return file_obj


def send_photo_safe(
    chat_id,
    url,
    caption=None,
    reply_markup=None
):

    if not url:

        return bot.send_message(
            chat_id,
            caption or "Фото отсутствует",
            reply_markup=reply_markup
        )

    content = download_photo(
        url
    )

    if content:

        try:

            photo_file = bytes_to_file(
                content
            )

            return bot.send_photo(
                chat_id,
                photo_file,
                caption=caption,
                reply_markup=reply_markup
            )

        except Exception as e:

            print(
                f"[PHOTO SEND] "
                f"Ошибка Telegram: {e}"
            )

    return bot.send_message(
        chat_id,
        caption or "Фото недоступно",
        reply_markup=reply_markup
    )


# ============================================================
# SAFE MEDIA GROUP
# ============================================================

def send_photo_album(
    chat_id,
    photos,
    caption=None
):
    """
    Надёжная отправка альбома.

    ВАЖНО:
    сюда никогда не передаются URL.

    Сначала каждое изображение скачивается,
    потом передаётся Telegram как файл.
    """

    if not photos:
        return []

    media = []

    for index, url in enumerate(
        photos[:MAX_PHOTOS]
    ):

        content = download_photo(
            url
        )

        if not content:

            print(
                f"[ALBUM] Пропускаем фото: {url}"
            )

            continue

        try:

            file_obj = bytes_to_file(
                content,
                filename=(
                    f"photo_{index + 1}.jpg"
                )
            )

            if index == 0 and caption:

                media_item = (
                    types.InputMediaPhoto(
                        file_obj,
                        caption=caption
                    )
                )

            else:

                media_item = (
                    types.InputMediaPhoto(
                        file_obj
                    )
                )

            media.append(
                media_item
            )

        except Exception as e:

            print(
                f"[ALBUM] Ошибка подготовки "
                f"фото: {e}"
            )

    if not media:

        return []

    # Telegram media group должен иметь 2-10 элементов.
    # Если осталась только одна фотография,
    # отправляем обычным сообщением.
    if len(media) == 1:

        try:

            sent = bot.send_photo(
                chat_id,
                media[0].media,
                caption=caption
            )

            ids = [
                sent.message_id
            ]

            user_album_msgs[
                chat_id
            ] = ids

            return ids

        except Exception as e:

            print(
                f"[ALBUM] Одиночное фото: {e}"
            )

            return []

    try:

        sent_messages = (
            bot.send_media_group(
                chat_id,
                media
            )
        )

        ids = [
            message.message_id
            for message in sent_messages
        ]

        user_album_msgs[
            chat_id
        ] = ids

        return ids

    except Exception as e:

        print(
            f"[ALBUM] Ошибка Telegram: {e}"
        )

        # ----------------------------------------------------
        # Fallback:
        # если Telegram отклонил группу,
        # отправляем фотографии по одной.
        # ----------------------------------------------------

        ids = []

        for index, media_item in enumerate(
            media
        ):

            try:

                message = bot.send_photo(
                    chat_id,
                    media_item.media,
                    caption=(
                        caption
                        if index == 0
                        else None
                    )
                )

                ids.append(
                    message.message_id
                )

            except Exception as photo_error:

                print(
                    f"[ALBUM] "
                    f"Fallback photo error: "
                    f"{photo_error}"
                )

        user_album_msgs[
            chat_id
        ] = ids

        return ids


