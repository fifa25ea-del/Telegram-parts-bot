def perform_search(
    chat_id,
    query
):
    query = safe_text(query)

    if len(query) < 2:
        bot.send_message(
            chat_id,
            "⚠️ Введите минимум 2 символа.",
            reply_markup=main_menu()
        )

        return

    mode = current_mode.get(
        chat_id,
        "parts"
    )

    if mode == "wheels":
        results = find_wheels(
            query
        )

    elif mode == "parts":
        results = find_part(
            query
        )

    else:
        current_mode[
            chat_id
        ] = "parts"

        results = find_part(
            query
        )

    track(
        chat_id,
        "searches"
    )

    log_search(
        chat_id,
        query,
        mode
    )

    if not results:
        try:
            now = datetime.now().strftime(
                "%Y-%m-%d %H:%M:%S"
            )

            with open(
                LOG_FILE,
                "a",
                encoding="utf-8"
            ) as f:
                f.write(
                    f"{now} | "
                    f"{chat_id} | "
                    f"{mode} | "
                    f"{query} | "
                    f"NOT_FOUND\n"
                )

        except Exception as e:
            print(
                f"[LOG] NOT_FOUND: {e}"
            )

        bot.send_message(
            chat_id,
            "❌ Ничего не найдено.\n\n"
            "Попробуйте другой номер "
            "или другой запрос.",
            reply_markup=main_menu()
        )

        return

    user_results[
        chat_id
    ] = results

    user_index[
        chat_id
    ] = 0

    user_photo_index[
        chat_id
    ] = 0

    # --------------------------------------------------------
    # Предпросмотр дисков.
    # --------------------------------------------------------

    if mode == "wheels":
        send_wheels_preview(
            chat_id,
            results
        )

        return

    # --------------------------------------------------------
    # Первая карточка запчасти.
    # --------------------------------------------------------

    send_part_card(
        chat_id,
        0
    )


