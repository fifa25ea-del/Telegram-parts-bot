def load_csv(url):

    headers = {
        "User-Agent": "Mozilla/5.0"
    }

    response = requests.get(
        url,
        headers=headers,
        timeout=60
    )

    response.raise_for_status()

    # Пробуем cp1251
    response.encoding = "cp1251"

    csv_file = io.StringIO(
        response.text
    )

    reader = csv.DictReader(
        csv_file,
        delimiter=";"
    )

    data = list(reader)

    return data, reader.fieldnames


