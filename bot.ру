# BUILD WEB ANSWER
# ============================================================

def build_web_answer(
    query,
    results
):
    if not results:
        return (
            "❌ По вашему запросу "
            "ничего не найдено."
        )

    lines = []

    lines.append(
        "🤖 Информация из интернета"
    )

    lines.append("")

    lines.append(
        f"🔎 Запрос: {query}"
    )

    lines.append("")

    lines.append(
        "━━━━━━━━━━━━━━━━━━"
    )

    for index, result in enumerate(
        results,
        start=1
    ):
        title = clean_web_text(
            result.get(
                "title",
                ""
            )
        )

        body = clean_web_text(
            result.get(
                "body",
                ""
            )
        )

        page_text = clean_web_text(
            result.get(
                "page_text",
                ""
            )
        )

        href = safe_text(
            result.get(
                "href",
                ""
            )
        )

        if not title:
            title = (
                f"Результат {index}"
            )

        lines.append("")
        lines.append(
            f"{index}. {title}"
        )

        # ----------------------------------------------------
        # Если страницу удалось открыть,
        # используем её текст.
        # ----------------------------------------------------

        if page_text:
            body = page_text

        if len(body) > WEB_RESULT_MAX_CHARS:
            body = (
                body[
                    :WEB_RESULT_MAX_CHARS
                ]
                + "..."
            )

        if body:
            lines.append(body)

        if href:
            lines.append(
                f"🌐 {href}"
            )

    return "\n".join(lines)


