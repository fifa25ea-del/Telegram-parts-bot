def get_item_id(item, fallback=""):
    """
    Уникальный ID товара.

    В первую очередь используем Артикул.
    """

    article = safe_text(item.get("Артикул"))

    if article:
        return article

    number = safe_text(item.get("Номер"))

    if number:
        return number

    return fallback


def is_favorite(chat_id, item):
    user_id = str(chat_id)

    item_id = get_item_id(item)

    return item_id in favorites.get(user_id, [])


def add_favorite(chat_id, item):
    user_id = str(chat_id)

    item_id = get_item_id(item)

    if not item_id:
        return False

    if user_id not in favorites:
        favorites[user_id] = []

    if item_id in favorites[user_id]:
        return False

    favorites[user_id].append(item_id)

    save_favorites()

    track(chat_id, "favorites")

    return True


def remove_favorite(chat_id, item_id):
    user_id = str(chat_id)

    if user_id not in favorites:
        return False

    if item_id not in favorites[user_id]:
        return False

    favorites[user_id].remove(item_id)

    save_favorites()

    return True


def find_favorite_items(chat_id):
    """
    Ищет избранные товары во всех базах.

    В отличие от старой версии, избранное теперь не зависит
    от того, какой поиск пользователь делал последним.
    """

    user_id = str(chat_id)

    ids = set(
        favorites.get(user_id, [])
    )

    if not ids:
        return []

    result = []

    # Запчасти
    for item in parts_db:
        item_id = get_item_id(item)

        if item_id in ids:
            result.append(
                ("parts", item)
            )

    # Диски
    for item in wheels_db:
        item_id = get_item_id(item)

        if item_id in ids:
            result.append(
                ("wheels", item)
            )

    return result


