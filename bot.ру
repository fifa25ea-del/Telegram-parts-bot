def send_photo_safe(
    chat_id,
    photo_url,
    caption=None,
    reply_markup=None
):

    if not photo_url:

        return bot.send_message(
            chat_id,
            caption or "",
            reply_markup=reply_markup
        )

    photo_url = str(
        photo_url
    ).strip()

    # ========================================================
    # СНАЧАЛА ПРОБУЕМ URL НАПРЯМУЮ
    # ========================================================

    try:

        return bot.send_photo(
            chat_id,
            photo_url,
            caption=caption,
            reply_markup=reply_markup
        )

    except Exception as e:

        print(
            "⚠️ Telegram не смог "
            "получить фото по URL:"
        )

        print(
            photo_url
        )

        print(
            "Причина:",
            e
        )


    # ========================================================
    # ЕСЛИ НЕ ПОЛУЧИЛОСЬ — КЭШ
    # ========================================================

    cache_path = get_photo_cache_path(
        photo_url
    )

    if os.path.exists(cache_path):

        try:

            with open(
                cache_path,
                "rb"
            ) as photo_file:

                return bot.send_photo(
                    chat_id,
                    photo_file,
                    caption=caption,
                    reply_markup=reply_markup
                )

        except Exception as e:

            print(
                "⚠️ Ошибка отправки "
                "фото из кэша:",
                e
            )


    # ========================================================
    # СКАЧИВАЕМ
    # ========================================================

    cache_path = download_photo_to_cache(
        photo_url
    )

    if cache_path:

        try:

            with open(
                cache_path,
                "rb"
            ) as photo_file:

                return bot.send_photo(
                    chat_id,
                    photo_file,
                    caption=caption,
                    reply_markup=reply_markup
                )

        except Exception as e:

            print(
                "❌ Ошибка отправки "
                "скачанного фото:",
                e
            )


    # ========================================================
    # ЕСЛИ ФОТО НЕ ПОЛУЧИЛОСЬ
    # ========================================================

    return bot.send_message(
        chat_id,
        caption or "",
        reply_markup=reply_markup
    )


