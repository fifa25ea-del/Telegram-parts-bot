def logs_cmd(
    message
):

    if (
        message.from_user.id
        != ADMIN_ID
    ):

        return

    if not os.path.exists(
        LOG_FILE
    ):

        bot.send_message(
            message.chat.id,
            "❌ Логов пока нет."
        )

        return

    try:

        with open(
            LOG_FILE,
            "rb"
        ) as f:

            bot.send_document(
                message.chat.id,
                f
            )

    except Exception as e:

        print(
            f"[LOGS] Ошибка: {e}"
        )

        bot.send_message(
            message.chat.id,
            "❌ Не удалось "
            "отправить логи."
        )


