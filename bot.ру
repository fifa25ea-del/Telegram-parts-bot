def load_csv(url):

    try:

        print(
            f"[CSV] Загрузка: {url}"
        )

        response = requests.get(
            url,
            headers=USER_AGENT,
            timeout=CSV_TIMEOUT
        )

        response.raise_for_status()

        raw = response.content

        # ----------------------------------------------------
        # Пробуем кодировки
        # ----------------------------------------------------

        text = None

        encodings = [
            "utf-8-sig",
            "cp1251",
            "utf-8"
        ]

        for encoding in encodings:

            try:

                text = raw.decode(
                    encoding
                )

                break

            except UnicodeDecodeError:
                continue

        if text is None:

            text = raw.decode(
                "utf-8",
                errors="replace"
            )

        text = text.lstrip(
            "\ufeff"
        )

        csv_file = io.StringIO(
            text
        )

        # ----------------------------------------------------
        # Определяем разделитель
        # ----------------------------------------------------

        sample = text[:10000]

        try:

            dialect = csv.Sniffer().sniff(
                sample,
                delimiters=";,\t"
            )

            delimiter = dialect.delimiter

        except Exception:

            delimiter = ";"

        reader = csv.DictReader(
            csv_file,
            delimiter=delimiter
        )

        rows = list(reader)

        headers = (
            reader.fieldnames
            or []
        )

        print(
            f"[CSV] Загружено "
            f"{len(rows)} строк"
        )

        print(
            f"[CSV] Колонки: "
            f"{headers[:20]}"
        )

        return rows, headers

    except Exception as e:

        print(
            f"[CSV] ОШИБКА: {e}"
        )

        return [], []


