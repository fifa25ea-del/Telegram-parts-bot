def find_part(query, db):
    """
    Поиск запчастей по артикулу / номеру.
    """

    query = normalize(query)

    if not query:
        return []

    results = []

    for part in db:

        values = []

        # Основные поля.
        if number_key:
            values.append(
                part.get(number_key, "")
            )

        values.extend([
            part.get("Артикул", ""),
            part.get("Номер", "")
        ])

        found = False

        for value in values:

            value_normalized = normalize(
                fix_a(value)
            )

            if not value_normalized:
                continue

            if query in value_normalized:
                found = True
                break

        if found:
            results.append(part)

        if len(results) >= MAX_RESULTS:
            break

    return results


def find_wheels(query, db):
    """
    Поиск дисков.

    Поддерживает:
    R18
    18
    AMG
    название модели
    производителя
    """

    original = safe_text(query)

    query_normalized = normalize(
        fix_a(original)
    )

    if not query_normalized:
        return []

    # Убираем R для поиска радиуса.
    radius_query = query_normalized

    if radius_query.startswith("r"):
        radius_query = radius_query[1:]

    results = []

    for part in db:

        radius = normalize(
            part.get(
                "Диаметр диска",
                ""
            )
        )

        brand = normalize(
            part.get(
                "Производитель диска",
                ""
            )
        )

        model = normalize(
            part.get(
                "Модель диска",
                ""
            )
        )

        article = normalize(
            part.get(
                "Артикул",
                ""
            )
        )

        # По радиусу.
        if radius_query and radius_query == radius:
            results.append(part)

        # По производителю.
        elif query_normalized in brand:
            results.append(part)

        # По модели.
        elif query_normalized in model:
            results.append(part)

        # По артикулу.
        elif query_normalized in article:
            results.append(part)

        if len(results) >= MAX_RESULTS:
            break

    return results


