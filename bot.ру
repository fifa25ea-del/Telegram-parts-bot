    chat_id,
    query
):
    query = safe_text(query)

    if len(query) < 2:
        bot.send_message(
            chat_id,
            "⚠️ Введите минимум 2 символа.",
            reply_markup=main_menu()
        )

        return

    print(
        f"[AI WEB] "
        f"{chat_id}: {query}"
    )

    track(
        chat_id,
        "searches"
    )

    log_search(
        chat_id,
        query,
        "AI_WEB"
    )

    loading_message_id = None

    try:
        loading = bot.send_message(
            chat_id,
            "🤖 Ищу информацию в интернете...\n\n"
            "⏳ Пожалуйста, подождите."
        )

        loading_message_id = (
            loading.message_id
        )

        # ----------------------------------------------------
        # Поиск.
        # ----------------------------------------------------

        results = web_search(
            query,
            max_results=WEB_SEARCH_RESULTS
        )

        if not results:
            safe_delete_message(
                chat_id,
                loading_message_id
            )

            bot.send_message(
                chat_id,
                "❌ По вашему запросу "
                "ничего не найдено.\n\n"
                "Попробуйте сформулировать "
                "вопрос немного иначе.",
                reply_markup=main_menu()
            )

            return

        # ----------------------------------------------------
        # Открываем несколько найденных страниц.
        # ----------------------------------------------------

        results = extract_web_pages_parallel(
            results
        )

        safe_delete_message(
            chat_id,
            loading_message_id
        )

        # ----------------------------------------------------
        # Сохраняем результаты.
        # ----------------------------------------------------

        user_results[
            chat_id
        ] = results

        user_index[
            chat_id
        ] = 0

        # ----------------------------------------------------
        # Формируем ответ.
        # ----------------------------------------------------

        answer = build_web_answer(
            query,
            results
        )

        chunks = split_message(
            answer,
            TELEGRAM_TEXT_LIMIT
        )

        for position, chunk in enumerate(
            chunks
        ):
            if position == len(chunks) - 1:
                bot.send_message(
                    chat_id,
                    chunk,
                    reply_markup=main_menu()
                )

            else:
                bot.send_message(
                    chat_id,
                    chunk
                )

    except Exception as e:
        print(
            f"[AI WEB] "
            f"ERROR: {repr(e)}"
        )

        if loading_message_id:
            safe_delete_message(
                chat_id,
                loading_message_id
            )

        bot.send_message(
            chat_id,
            "❌ Произошла ошибка "
            "при поиске в интернете.\n\n"
            "Попробуйте ещё раз.",
            reply_markup=main_menu()
        )


