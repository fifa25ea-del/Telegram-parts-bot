def find_part(query, db):
    """
    Поиск по артикулу / номеру.

    Например:
    A000123
    A 000-123
    а000123
    """

    query = normalize(
        fix_a(query)
    )

    if not query:
        return []

    results = []

    for part in db:

        # Основной ключ
        values = []

        if number_key:
            values.append(
                part.get(number_key, "")
            )

        # Резервные поля
        values.append(
            part.get("Артикул", "")
        )

        values.append(
            part.get("Номер", "")
        )

        found = False

        for raw_value in values:

            value = normalize(
                fix_a(raw_value)
            )

            if not value:
                continue

            if query in value:
                found = True
                break

        if found:
            results.append(part)

        if len(results) >= MAX_RESULTS:
            break

    return results


def find_part_by_id(item_id):
    """
    Ищет конкретную деталь для избранного.
    """

    target = normalize(
        fix_a(item_id)
    )

    if not target:
        return None

    for part in parts_db:

        values = [
            part.get("Артикул", "")
        ]

        if number_key:
            values.append(
                part.get(number_key, "")
            )

        for value in values:

            current = normalize(
                fix_a(value)
            )

            if current == target:
                return part

    return None


