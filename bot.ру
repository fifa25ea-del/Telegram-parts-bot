def build_indexes(parts):

    new_article_index = defaultdict(list)
    new_number_index = defaultdict(list)

    print("🔎 Построение индексов...")

    for part in parts:

        # ------------------------------
        # Артикул
        # ------------------------------

        article = normalize(
            part.get("Артикул", "")
        )

        if article:

            new_article_index[
                article
            ].append(part)

        # ------------------------------
        # Номер
        # ------------------------------

        number = normalize(
            part.get("Номер", "")
        )

        if number:

            new_number_index[
                number
            ].append(part)

    return (
        new_article_index,
        new_number_index
    )


