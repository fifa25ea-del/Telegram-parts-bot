@bot.callback_query_handler(
    func=lambda call:
        call.data.startswith("fav_")
)
def callback_favorite(
    call
):

    # Отвечаем МОМЕНТАЛЬНО.
    safe_callback_answer(
        call
    )

    chat_id = call.message.chat.id

    try:

        index = int(
            call.data.split(
                "_",
                1
            )[1]
        )

    except Exception:

        return

    results = user_results.get(
        chat_id,
        []
    )

    if (
        index < 0
        or index >= len(results)
    ):

        return

    item = results[index]

    try:

        if is_favorite(
            chat_id,
            item
        ):

            item_id = get_item_id(
                item
            )

            remove_favorite(
                chat_id,
                item_id
            )

            message_text = (
                "💔 Удалено из избранного"
            )

        else:

            add_favorite(
                chat_id,
                item
            )

            message_text = (
                "❤️ Добавлено в избранное"
            )

        # Второй answer_callback_query
        # иногда уже может быть слишком поздним.
        # Поэтому просто отправляем уведомление.
        try:

            bot.send_message(
                chat_id,
                message_text
            )

        except Exception as e:

            print(
                f"[FAVORITE MSG] {e}"
            )

        mode = current_mode.get(
            chat_id
        )

        if mode == "parts":

            send_part_card(
                chat_id,
                index
            )

        elif mode == "wheels":

            send_wheel_card(
                chat_id,
                index
            )

    except Exception as e:

        print(
            f"[FAVORITE] Ошибка: {e}"
        )


