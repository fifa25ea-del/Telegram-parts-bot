def load_database():

    global parts_db
    global wheels_db
    global donors_db

    global number_key
    global name_key
    global photo_key

    global article_index
    global number_index

    print("🔄 Загрузка CSV...")

    try:

        # ====================================================
        # ДОНОРЫ
        # ====================================================

        new_donors_db, _ = load_csv(
            DONORS_CSV
        )

        new_donors_db.reverse()


        # ====================================================
        # ЗАПЧАСТИ
        # ====================================================

        new_parts_db, headers = load_csv(
            PARTS_CSV
        )

        new_parts_db.reverse()


        # ====================================================
        # ДИСКИ
        # ====================================================

        new_wheels_db, _ = load_csv(
            WHEELS_CSV
        )


        # ====================================================
        # ОПРЕДЕЛЯЕМ КОЛОНКИ
        # ====================================================

        new_number_key = None
        new_name_key = None
        new_photo_key = None

        for h in headers:

            if not h:
                continue

            h_low = h.lower()

            if (
                "артикул" in h_low
                or "номер" in h_low
            ):
                new_number_key = h

            if (
                "наимен" in h_low
                or "название" in h_low
            ):
                new_name_key = h

            if (
                "фото" in h_low
                or "image" in h_low
            ):
                new_photo_key = h


        # ====================================================
        # ИНДЕКСЫ
        # ====================================================

        (
            new_article_index,
            new_number_index
        ) = build_indexes(
            new_parts_db
        )


        # ====================================================
        # АТОМАРНАЯ ЗАМЕНА БАЗЫ
        # ====================================================

        with db_lock:

            donors_db = new_donors_db
            parts_db = new_parts_db
            wheels_db = new_wheels_db

            number_key = new_number_key
            name_key = new_name_key
            photo_key = new_photo_key

            article_index = new_article_index
            number_index = new_number_index


        print(
            "✅ CSV загружен:"
        )

        print(
            f"   Запчастей: {len(parts_db)}"
        )

        print(
            f"   Дисков: {len(wheels_db)}"
        )

        print(
            f"   Доноров: {len(donors_db)}"
        )

        print(
            f"   Индексов артикулов: "
            f"{len(article_index)}"
        )

        print(
            f"   Индексов номеров: "
            f"{len(number_index)}"
        )

        return True

    except Exception as e:

        print(
            "❌ Ошибка загрузки CSV:",
            e
        )

        return False


