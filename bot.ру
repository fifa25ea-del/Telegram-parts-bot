def find_column(
    headers,
    variants
):

    if not headers:
        return None

    normalized = {}

    for header in headers:

        if header is None:
            continue

        normalized[
            normalize(header)
        ] = header

    # Сначала точное совпадение.
    for variant in variants:

        key = normalize(
            variant
        )

        if key in normalized:

            return normalized[key]

    # Затем частичное.
    for variant in variants:

        key = normalize(
            variant
        )

        for existing, original in (
            normalized.items()
        ):

            if key in existing:

                return original

    return None


