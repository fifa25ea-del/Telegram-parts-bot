def fix_a(text):
    """
    Исправляет русскую 'а' на латинскую 'a'.

    Например:
    А2515453732 -> A2515453732
    """

    return str(text).lower().replace("а", "a")


def normalize(text):
    """
    Приводит строку к виду, удобному для поиска.

    Убирает:
    - пробелы
    - дефисы
    - некоторые разделители
    """

    text = fix_a(str(text))

    return (
        text
        .lower()
        .replace(" ", "")
        .replace("-", "")
        .replace("_", "")
        .replace("/", "")
        .replace(".", "")
    )


def split_words(text):
    return re.findall(r"\w+", str(text).lower())


