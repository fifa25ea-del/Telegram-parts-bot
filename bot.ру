def get_photo_cache_path(url):

    url_hash = hashlib.md5(
        url.encode("utf-8")
    ).hexdigest()

    return os.path.join(
        PHOTO_CACHE_DIR,
        url_hash + ".jpg"
    )


def download_photo_to_cache(url):

    if not url:
        return None

    url = str(url).strip()

    if not url.startswith("http"):
        return None

    cache_path = get_photo_cache_path(
        url
    )

    # Уже есть
    if os.path.exists(cache_path):

        try:

            if os.path.getsize(
                cache_path
            ) > 0:

                return cache_path

        except Exception:
            pass

    try:

        headers = {
            "User-Agent":
                "Mozilla/5.0"
        }

        response = requests.get(
            url,
            headers=headers,
            timeout=10
        )

        response.raise_for_status()

        content_type = response.headers.get(
            "Content-Type",
            ""
        ).lower()

        if (
            content_type
            and "image" not in content_type
        ):

            print(
                "⚠️ URL не является фото:",
                content_type
            )

            return None

        with open(
            cache_path,
            "wb"
        ) as f:

            f.write(
                response.content
            )

        print(
            "💾 Фото сохранено:",
            cache_path
        )

        return cache_path

    except Exception as e:

        print(
            "❌ Ошибка скачивания фото:",
            e
        )

        return None


