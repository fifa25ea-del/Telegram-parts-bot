def clean_web_text(text):

    text = safe_text(text)

    if not text:
        return ""

    # HTML entities
    text = unescape(text)

    # Убираем replacement characters
    text = text.replace("\ufffd", " ")

    # Схлопываем пробелы
    text = re.sub(
