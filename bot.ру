@bot.message_handler(
    func=lambda message: True
)
def fallback_handler(message):

    text = message.text or ""

    # Не мешаем командам
    if text.startswith("/"):
        return

    # Не мешаем основным кнопкам
    if text in (
        "🚗 Найти запчасть",
        "🛞 Шины и диски",
        "❤️ Избранное",
        "🚘 В разборе"
    ):
        return

    bot.send_message(
        message.chat.id,
        "Выберите действие из меню:",
        reply_markup=main_menu()
    )


