def navigate_results(
    call,
    direction
):

    chat_id = call.message.chat.id

    results = user_results.get(
        chat_id,
        []
    )

    if not results:

        bot.answer_callback_query(
            call.id,
            "Нет данных"
        )

        return

    current = user_index.get(
        chat_id,
        0
    )

    if direction == "next":

        current += 1

    else:

        current -= 1

    if current < 0:

        current = len(results) - 1

    if current >= len(results):

        current = 0

    user_index[chat_id] = current
    user_photo_index[chat_id] = 0

    mode = current_mode.get(
        chat_id,
        "parts"
    )

    # ========================================================
    # ДИСКИ
    # ========================================================

    if mode == "wheels":

        edit_wheel_card(
            call,
            current
        )

        return

    # ========================================================
    # ДОНОРЫ
    # ========================================================

    if mode == "donors":

        edit_donor_card(
            call,
            current
        )

        return

    # ========================================================
    # ЗАПЧАСТИ
    # ========================================================

    # Для запчастей удаляем старую карточку
    delete_last_messages(
        chat_id
    )

    send_part_card(
        chat_id,
        current
    )

    try:
        bot.answer_callback_query(
            call.id
        )
    except Exception:
        pass


