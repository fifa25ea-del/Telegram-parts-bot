def ensure_cache_dir():

    try:

        os.makedirs(
            PHOTO_CACHE_DIR,
            exist_ok=True
        )

    except Exception as e:

        print(
            f"[CACHE] Не удалось создать "
            f"{PHOTO_CACHE_DIR}: {e}"
        )


def photo_cache_path(url):

    digest = hashlib.sha256(
        url.encode(
            "utf-8",
            errors="ignore"
        )
    ).hexdigest()

    # Пытаемся сохранить расширение.
    clean_url = url.lower()

    extension = ".jpg"

    for ext in (
        ".jpg",
        ".jpeg",
        ".png",
        ".webp"
    ):

        if ext in clean_url:

            extension = ext
            break

    return os.path.join(
        PHOTO_CACHE_DIR,
        digest + extension
    )


def read_cached_photo(url):

    path = photo_cache_path(
        url
    )

    if not os.path.exists(path):
        return None

    try:

        with open(
            path,
            "rb"
        ) as f:

            data = f.read()

        if not data:
            return None

        return data

    except Exception as e:

        print(
            f"[CACHE] Ошибка чтения: {e}"
        )

        return None


def save_cached_photo(
    url,
    content
):

    path = photo_cache_path(
        url
    )

    temp = path + ".tmp"

    try:

        with open(
            temp,
            "wb"
        ) as f:

            f.write(content)

        os.replace(
            temp,
            path
        )

        return True

    except Exception as e:

        print(
            f"[CACHE] Ошибка записи: {e}"
        )

        try:

            if os.path.exists(temp):
                os.remove(temp)

        except Exception:
            pass

        return False


def download_photo(url):

    if not url:
        return None

    if not (
        url.startswith("http://")
        or url.startswith("https://")
    ):
        return None

    ensure_cache_dir()

    # --------------------------------------------------------
    # 1. Сначала локальный кэш
    # --------------------------------------------------------

    cached = read_cached_photo(
        url
    )

    if cached:

        print(
            f"[PHOTO CACHE] HIT: {url}"
        )

        return cached

    # --------------------------------------------------------
    # 2. Скачиваем
    # --------------------------------------------------------

    print(
        f"[PHOTO CACHE] DOWNLOAD: {url}"
    )

    try:

        response = requests.get(
            url,
            headers=USER_AGENT,
            timeout=REQUEST_TIMEOUT
        )

        if response.status_code != 200:

            print(
                f"[PHOTO] HTTP "
                f"{response.status_code}: "
                f"{url}"
            )

            return None

        content = response.content

        if not content:
            return None

        # ----------------------------------------------------
        # Защита от HTML вместо картинки
        # ----------------------------------------------------

        content_type = (
            response.headers
            .get(
                "Content-Type",
                ""
            )
            .lower()
        )

        if (
            "text/html" in content_type
            and not content.startswith(
                b"\xff\xd8"
            )
        ):

            print(
                f"[PHOTO] Сервер вернул HTML: "
                f"{url}"
            )

            return None

        save_cached_photo(
            url,
            content
        )

        return content

    except requests.RequestException as e:

        print(
            f"[PHOTO] Request error: "
            f"{url}: {e}"
        )

        return None

    except Exception as e:

        print(
            f"[PHOTO] Error: "
            f"{url}: {e}"
        )

        return None


