def clean_web_text(text):

    text = safe_text(text)

    if not text:
        return ""

    text = unescape(text)

    # Удаляем replacement characters.
    text = text.replace("\ufffd", " ")

    # Иногда браузер/сайт оставляет zero-width символы.
    text = re.sub(
        r"[\u200b-\u200f\u2060\ufeff]",
        "",
        text
    )

    # Схлопываем пробелы.
    text = re.sub(
        r"\s+",
        " ",
        text
    )

    return text.strip()


