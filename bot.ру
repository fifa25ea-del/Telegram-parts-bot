def get_cached_photo(url):
    if not url:
        return None

    path = photo_cache_path(url)

    if not os.path.exists(path):
        return None

    try:
        with open(path, "rb") as f:
            return f.read()

    except Exception as e:
        print(f"[CACHE] read: {e}")
        return None


def save_cached_photo(url, content):
    if not url or not content:
        return

    path = photo_cache_path(url)
    temp_path = path + ".tmp"

    try:
        with photo_cache_lock:
            with open(temp_path, "wb") as f:
                f.write(content)

            os.replace(
                temp_path,
                path
            )

    except Exception as e:
        print(f"[CACHE] write: {e}")

        try:
            if os.path.exists(temp_path):
                os.remove(temp_path)

        except Exception:
            pass


def download_photo(url):
    if not url:
        return None

    if not (
        url.startswith("http://")
        or url.startswith("https://")
    ):
        return None

    # --------------------------------------------------------
    # Проверяем кэш.
    # --------------------------------------------------------

    cached = get_cached_photo(url)

    if cached:
        return cached

    # --------------------------------------------------------
    # Загружаем фотографию.
    # --------------------------------------------------------

    try:
        response = requests.get(
            url,
            headers=USER_AGENT,
            timeout=REQUEST_TIMEOUT
        )

        if response.status_code != 200:
            print(
                f"[PHOTO] HTTP "
                f"{response.status_code}: {url}"
            )

            return None

        content = response.content

        if not content:
            return None

        content_type = (
            response.headers.get(
                "Content-Type",
                ""
            ).lower()
        )

        # ----------------------------------------------------
        # Иногда вместо фотографии сервер
        # возвращает HTML.
        # ----------------------------------------------------

        if "text/html" in content_type:
            print(
                "[PHOTO] HTML instead "
                "of image:",
                url
            )

            return None

        # ----------------------------------------------------
        # Сохраняем в кэш.
        # ----------------------------------------------------

        save_cached_photo(
            url,
            content
        )

        return content

    except requests.RequestException as e:
        print(
            f"[PHOTO] Request error: {e}"
        )

        return None

    except Exception as e:
        print(
            f"[PHOTO] Error: {e}"
        )

        return None


# ============================================================
# PARALLEL PHOTO DOWNLOAD
# ============================================================

def download_photos_parallel(urls):
    unique_urls = []
    seen = set()

    for url in urls:
        if not url:
            continue

        url = safe_text(url)

        if not url:
            continue

        if url in seen:
            continue

        seen.add(url)
        unique_urls.append(url)

    if not unique_urls:
        return []

    results = {}

    missing = []

    # --------------------------------------------------------
    # Сначала пытаемся взять всё из кэша.
    # --------------------------------------------------------

    for url in unique_urls:
        cached = get_cached_photo(url)

        if cached:
            results[url] = cached

        else:
            missing.append(url)

    # --------------------------------------------------------
    # Недостающие фотографии скачиваем параллельно.
    # --------------------------------------------------------

    if missing:
        with ThreadPoolExecutor(
            max_workers=PHOTO_WORKERS
        ) as executor:

            futures = {
                executor.submit(
                    download_photo,
                    url
                ): url
                for url in missing
            }

            for future in as_completed(futures):
                url = futures[future]

                try:
                    content = future.result()

                    if content:
                        results[url] = content

                except Exception as e:
                    print(
                        "[PHOTO] Worker error:",
                        e
                    )

    # --------------------------------------------------------
    # Возвращаем фотографии в исходном порядке.
    # --------------------------------------------------------

    return [
        results[url]
        for url in unique_urls
        if url in results
    ]


# ============================================================
# PHOTO CACHE CLEANUP
# ============================================================

def cleanup_photo_cache():
    try:
        files = []
        total_size = 0

        for filename in os.listdir(
            PHOTO_CACHE_DIR
        ):
            path = os.path.join(
                PHOTO_CACHE_DIR,
                filename
            )

            if not os.path.isfile(path):
                continue

            try:
                stat = os.stat(path)

                files.append(
                    (
                        path,
                        stat.st_mtime,
                        stat.st_size
                    )
                )

                total_size += stat.st_size

            except Exception:
                continue

        max_bytes = (
            PHOTO_CACHE_MAX_MB
            * 1024
            * 1024
        )

        if total_size <= max_bytes:
            return

        # Старые файлы удаляем первыми.
        files.sort(
            key=lambda item: item[1]
        )

        deleted = 0

        for path, _mtime, size in files:
            if total_size <= max_bytes:
                break

            try:
                os.remove(path)

                total_size -= size
                deleted += 1

            except Exception:
                pass

        print(
            f"[CACHE] Deleted "
            f"{deleted} old photos"
        )

    except Exception as e:
        print(
            f"[CACHE] Cleanup error: {e}"
        )


