def load_csv(url):

    try:

        print(
            f"[CSV] Loading: {url}"
        )

        response = requests.get(
            url,
            headers=USER_AGENT,
            timeout=CSV_TIMEOUT
        )

        response.raise_for_status()

        content = response.content

        try:

            text = content.decode(
                "utf-8-sig"
            )

        except UnicodeDecodeError:

            text = content.decode(
                "cp1251",
                errors="replace"
            )

        text = text.lstrip(
            "\ufeff"
        )

        csv_file = io.StringIO(
            text
        )

        sample = text[:10000]

        delimiter = ";"

        try:

            dialect = csv.Sniffer().sniff(
                sample,
                delimiters=";,|\t"
            )

            delimiter = (
                dialect.delimiter
            )

        except Exception:

            delimiter = ";"

        reader = csv.DictReader(
            csv_file,
            delimiter=delimiter
        )

        rows = list(
            reader
        )

        headers = (
            reader.fieldnames
            or []
        )

        print(
            f"[CSV] Loaded "
            f"{len(rows)} rows"
        )

        print(
            f"[CSV] Headers: "
            f"{headers}"
        )

        return rows, headers

    except Exception as e:

        print(
            f"[CSV] ERROR: {e}"
        )

        return [], []


# ============================================================
# FIND COLUMN
# ============================================================

def find_column(
    headers,
    variants
):

    if not headers:
        return None

    normalized = {}

    for header in headers:

        normalized[
            normalize(header)
        ] = header

    for variant in variants:

        variant_normalized = normalize(
            variant
        )

        for key, original in normalized.items():

            if (
                variant_normalized == key
                or
                variant_normalized in key
                or
                key in variant_normalized
            ):

                return original

    return None


