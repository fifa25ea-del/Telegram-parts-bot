        remove_favorite(
            chat_id,
            item_id
        )

        safe_callback_answer(
            call,
            "💔 Удалено из избранного"
        )

    else:

        add_favorite(
            chat_id,
            item
        )

        safe_callback_answer(
            call,
            "❤️ Добавлено в избранное"
        )

    mode = current_mode.get(
        chat_id,
        "parts"
    )

    try:

        if mode == "parts":

            send_part_card(
                chat_id,
                index
            )

        elif mode == "wheels":

            send_wheel_card(
                chat_id,
                index
            )

