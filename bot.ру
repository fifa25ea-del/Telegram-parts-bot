    current = user_index.get(
        chat_id,
        0
    )

    if call.data.startswith(
        "next_"
    ):

        current += 1

    else:

        current -= 1

    if current >= len(results):
        current = 0

    if current < 0:
        current = len(results) - 1

    user_index[chat_id] = current
    user_photo_index[chat_id] = 0

    mode = current_mode.get(
        chat_id,
        "parts"
    )

    try:

        if mode == "parts":

            send_part_card(
                chat_id,
                current
            )

        elif mode == "wheels":

            send_wheel_card(
                chat_id,
                current
            )

        elif mode == "donors":

            send_donor_card(
                chat_id,
                current
            )

    except Exception as e:

        print(
            f"[NAVIGATION] Ошибка: {e}"
        )


