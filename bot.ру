def send_photo_album(
    chat_id,
    photos,
    caption=None
):
    photos = photos[:MAX_PHOTOS]

    if not photos:
        return []

    contents = download_photos_parallel(
        photos
    )

    if not contents:
        return []

    media = []

    for index, content in enumerate(contents):
        try:
            if index == 0 and caption:
                media.append(
                    types.InputMediaPhoto(
                        content,
                        caption=caption
                    )
                )

            else:
                media.append(
                    types.InputMediaPhoto(
                        content
                    )
                )

        except Exception as e:
            print(
                f"[ALBUM] Media error: {e}"
            )

    if not media:
        return []

    try:
        sent_messages = (
            bot.send_media_group(
                chat_id,
                media
            )
        )

        ids = [
            message.message_id
            for message in sent_messages
        ]

        user_album_msgs[
            chat_id
        ] = ids

        return ids

    except Exception as e:
        print(
            f"[ALBUM] Telegram error: {e}"
        )

        # ----------------------------------------------------
        # Если Telegram не принял альбом,
        # отправляем фотографии по одной.
        # ----------------------------------------------------

        ids = []

        for index, content in enumerate(contents):
            try:
                msg = bot.send_photo(
                    chat_id,
                    content,
                    caption=(
                        caption
                        if index == 0
                        else None
                    )
                )

                ids.append(
                    msg.message_id
                )

            except Exception as single_error:
                print(
                    "[ALBUM] Single photo error:",
                    single_error
                )

        user_album_msgs[
            chat_id
        ] = ids

        return ids


