    for user_id, data in top:

        text += (
            f"ID: {user_id}\n"
            f"👁 "
            f"{data.get('views', 0)} "
            f"просмотров\n\n"
        )

    bot.send_message(
        message.chat.id,
        text
    )


# ============================================================
#                       LOGS
# ============================================================

@bot.message_handler(
    commands=["logs"]
)
def logs_command(message):

    if message.chat.id != ADMIN_ID:
        return

    try:

        with open(
            LOG_FILE,
            "rb"
        ) as f:

            bot.send_document(
                message.chat.id,
                f
            )

    except Exception as e:

        print(
            "Ошибка логов:",
            e
        )

        bot.send_message(
            message.chat.id,
            "❌ Логов пока нет"
        )


# ============================================================
#                 НЕИЗВЕСТНЫЕ КОМАНДЫ/ТЕКСТ
# ============================================================

@bot.message_handler(
    func=lambda message: True
)
def fallback_handler(message):

    # Команды уже обработаны
    if message.text.startswith("/"):
        return

    # Если пользователь находится
    # в режиме поиска — ничего не делаем,
    # потому что search_handler выше уже обработал его.
    mode = current_mode.get(
        message.chat.id
    )

    if mode in (
        "parts",
        "wheels"
    ):

        return

    bot.send_message(
        message.chat.id,
        "Выберите действие из меню:",
        reply_markup=main_menu()
    )


