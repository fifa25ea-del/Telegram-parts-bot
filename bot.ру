    )

    if call.data.startswith(
        "next_"
    ):

        current += 1

    else:

        current -= 1

    if current >= len(results):

        current = 0

    if current < 0:

        current = (
            len(results) - 1
        )

    user_index[
        chat_id
    ] = current

    user_photo_index[
        chat_id
    ] = 0

    try:

        send_card(
            chat_id,
            current
        )

