def send_photo_album(
    chat_id,
    photos,
    caption=None
):

    if not photos:
        return []

    media = []

    for index, url in enumerate(
        photos[:MAX_PHOTOS]
    ):

        content = download_photo(
            url
        )

        if not content:
            continue

        try:

            photo_file = io.BytesIO(
                content
            )

            photo_file.name = "photo.jpg"

            if (
                index == 0
                and caption
            ):

                media.append(
                    types.InputMediaPhoto(
                        photo_file,
                        caption=caption
                    )
                )

            else:

                media.append(
                    types.InputMediaPhoto(
                        photo_file
                    )
                )

        except Exception as e:

            print(
                f"[ALBUM] Ошибка media: "
                f"{e}"
            )

    if not media:
        return []

    # Telegram media group:
    # максимум 10 элементов.
    media = media[:10]

    try:

        sent_messages = (
            bot.send_media_group(
                chat_id,
                media
            )
        )

        ids = [
            message.message_id
            for message in sent_messages
        ]

        user_album_msgs[chat_id] = ids

        return ids

    except Exception as e:

        print(
            f"[ALBUM] Ошибка Telegram: "
            f"{e}"
        )

        return []


