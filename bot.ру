def safe_text(value):
    if value is None:
        return ""
    return str(value).strip()


def normalize(text):
    """
    Нормализация поиска.

    В том числе исправляет распространённую проблему:
    русские/латинские символы в номере Mercedes.
    """

    text = safe_text(text).lower()

    replacements = {
        "а": "a",
        "в": "b",
        "с": "c",
        "е": "e",
        "н": "h",
        "к": "k",
        "м": "m",
        "о": "o",
        "р": "p",
        "т": "t",
        "х": "x",
        "у": "y",
    }

    for old, new in replacements.items():
        text = text.replace(old, new)

    text = re.sub(r"[\s\-_./\\]+", "", text)

    return text


def fix_a(text):
    return safe_text(text).lower().replace("а", "a")


def first_photo(value):
    if not value:
        return None

    for photo in str(value).split(","):
        photo = photo.strip()

        if photo.startswith(("http://", "https://")):
            return photo

    return None


def photo_list(value):
    if not value:
        return []

    result = []

    for photo in str(value).split(","):
        photo = photo.strip()

        if photo.startswith(("http://", "https://")):
            result.append(photo)

    return result[:MAX_PHOTOS]


def split_message(text, limit=TELEGRAM_TEXT_LIMIT):
    text = safe_text(text)

    if not text:
        return []

    result = []
    current = ""

    for line in text.splitlines(keepends=True):

        if len(current) + len(line) <= limit:
            current += line
            continue

        if current:
            result.append(current)

        while len(line) > limit:
            result.append(line[:limit])
            line = line[limit:]

        current = line

    if current:
        result.append(current)

    return result


def unique_preserve_order(values):
    seen = set()
    result = []

    for value in values:
        if value in seen:
            continue

        seen.add(value)
        result.append(value)

    return result


