def find_part(query):
    query_normalized = normalize(fix_a(query))

    if not query_normalized:
        return []

    with database_lock:

        positions = set()

        # Точное / префиксное индексированное совпадение.
        if query_normalized in parts_index:
            positions.update(
                parts_index[query_normalized]
            )

        elif len(query_normalized) >= 4:
            positions.update(
                parts_index.get(
                    query_normalized[:4],
                    set()
                )
            )

        results = []

        for position in sorted(positions):

            if position >= len(parts_db):
                continue

            part = parts_db[position]

            searchable = [
                part.get("Артикул", ""),
                part.get("ID", ""),
                part.get("Номер", ""),
                part.get(name_key, "") if name_key else "",
                part.get(cross_numbers_key, "")
                if cross_numbers_key else "",
                part.get(manufacturer_number_key, "")
                if manufacturer_number_key else ""
            ]

            found = False

            for value in searchable:

                normalized_value = normalize(
                    fix_a(value)
                )

                if query_normalized in normalized_value:
                    found = True
                    break

                # Для CSV со списком номеров.
                for number in re.split(
                    r"[,;/|\n]+",
                    safe_text(value)
                ):
                    if query_normalized in normalize(
                        fix_a(number)
                    ):
                        found = True
                        break

                if found:
                    break

            if found:
                results.append(part)

            if len(results) >= MAX_RESULTS:
                return results

        # Fallback.
        # Нужен на случай нестандартного значения,
        # которое не попало в индекс.
        if not results:

            for part in parts_db:

                searchable = [
                    part.get("Артикул", ""),
                    part.get("ID", ""),
                    part.get("Номер", ""),
                    part.get(name_key, "")
                    if name_key else "",
                    part.get(cross_numbers_key, "")
                    if cross_numbers_key else "",
                    part.get(manufacturer_number_key, "")
                    if manufacturer_number_key else ""
                ]

                if any(
                    query_normalized
                    in normalize(fix_a(value))
                    for value in searchable
                ):
                    results.append(part)

                if len(results) >= MAX_RESULTS:
                    break

        return results


