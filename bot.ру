def safe_text(value):
    """
    Безопасно превращает значение в строку.
    """
    if value is None:
        return ""

    return str(value).strip()


def normalize(text):
    """
    Нормализация строки для поиска.

    Убираем пробелы, дефисы и некоторые разделители.
    """
    text = safe_text(text).lower()

    # Латинская a и кириллическая а
    text = text.replace("а", "a")

    # Убираем пробелы/дефисы
    text = re.sub(r"[\s\-_./]+", "", text)

    return text


def split_words(text):
    return re.findall(r"\w+", safe_text(text).lower())


def fix_a(text):
    return safe_text(text).lower().replace("а", "a")


def first_photo(value):
    """
    Возвращает первое корректное HTTP-фото из строки CSV.
    """
    if not value:
        return None

    photos = str(value).split(",")

    for photo in photos:
        photo = photo.strip()

        if photo.startswith("http://") or photo.startswith("https://"):
            return photo

    return None


def photo_list(value):
    """
    Возвращает список URL фотографий.
    """
    if not value:
        return []

    result = []

    for photo in str(value).split(","):
        photo = photo.strip()

        if photo.startswith("http://") or photo.startswith("https://"):
            result.append(photo)

    return result[:MAX_PHOTOS]


