                []
            )
        )

    if not ids:
        return []

    result = []

    with database_lock:

        for item in parts_db:

            item_id = get_item_id(
                item
            )

            if item_id in ids:

                result.append(
                    (
                        "parts",
                        item
                    )
                )

        for item in wheels_db:

            item_id = get_item_id(
                item
            )

            if item_id in ids:

                result.append(
                    (
                        "wheels",
                        item
                    )
                )

    return result


