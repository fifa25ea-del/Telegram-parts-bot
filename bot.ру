def split_words(text):
    return re.findall(r"\w+", str(text).lower())


def fix_a(text):
    """
    Исправляет кириллическую 'а' на латинскую 'a'.
    Это полезно для артикулов, где пользователь может
    случайно ввести кириллическую букву.
    """
    return str(text).lower().replace("а", "a")


def normalize(text):
    """
    Нормализация поискового текста.
    Убираем пробелы и дефисы.
    """
    return (
        str(text)
        .lower()
        .replace(" ", "")
        .replace("-", "")
        .strip()
    )


def safe_int(value, default=0):
    try:
        return int(value)
    except Exception:
        return default


def clean_url(value):
    """
    Берёт первую валидную ссылку из строки CSV.
    """
    if not value:
        return None

    value = str(value).strip()

    if not value:
        return None

    parts = value.split(",")

    for item in parts:
        url = item.strip()

        if url.startswith("http://") or url.startswith("https://"):
            return url

    return None


def get_photo_list(value):
    """
    Получает список URL фотографий из CSV.
    """
    if not value:
        return []

    result = []

    for item in str(value).split(","):
        url = item.strip()

        if url.startswith("http://") or url.startswith("https://"):
            result.append(url)

    return result


