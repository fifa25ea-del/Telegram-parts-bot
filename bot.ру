def find_wheels(query, db=None):

    query = normalize(query)

    results = []

    with db_lock:

        current_db = wheels_db

        for part in current_db:

            radius = normalize(
                part.get(
                    "Диаметр диска",
                    ""
                )
            )

            brand = str(
                part.get(
                    "Производитель диска",
                    ""
                )
            ).lower()

            model = str(
                part.get(
                    "Модель диска",
                    ""
                )
            ).lower()

            article = normalize(
                part.get(
                    "Артикул",
                    ""
                )
            )

            # R18 / 18
            if (
                query in radius
                or query in f"r{radius}"
            ):

                results.append(part)

            # Бренд
            elif query in brand:

                results.append(part)

            # Модель
            elif query in model:

                results.append(part)

            # Артикул
            elif query in article:

                results.append(part)

            if len(results) >= 20:
                break

    return results


