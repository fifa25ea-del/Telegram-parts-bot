def load_csv(url):
    """
    Загружает CSV.
    По твоему исходному коду используется:
    delimiter=';'
    encoding='cp1251'
    """

    headers = {
        "User-Agent": "Mozilla/5.0"
    }

    print("Загрузка CSV:", url)

    response = requests.get(
        url,
        headers=headers,
        timeout=REQUEST_TIMEOUT
    )

    response.raise_for_status()

    # Пробуем cp1251, как в исходном боте
    response.encoding = "cp1251"

    csv_file = io.StringIO(
        response.text
    )

    reader = csv.DictReader(
        csv_file,
        delimiter=";"
    )

    rows = list(reader)

    print(
        f"Загружено строк: {len(rows)}"
    )

    return rows, reader.fieldnames or []


