def get_not_found():

    try:

        with open(
            LOG_FILE,
            "r",
            encoding="utf-8"
        ) as f:

            lines = f.readlines()

        data = defaultdict(list)

        for line in lines:

            if "NOT_FOUND" not in line:
                continue

            parts = line.strip().split("|")

            if len(parts) >= 4:

                chat_id = parts[1].strip()

                query = parts[3].strip()

                data[query].append(
                    chat_id
                )

        if not data:

            return (
                "Нет пустых запросов 👍"
            )

        text = (
            "❌ Ничего не найдено:\n\n"
        )

        for query, users in data.items():

            unique_users = list(
                set(users)
            )

            text += (
                f"🔍 {query}\n"
            )

            text += (
                f"👤 ID: "
                f"{', '.join(unique_users)}\n"
            )

            text += (
                f"📊 Запросов: "
                f"{len(users)}\n\n"
            )

        return text

    except Exception as e:

        return (
            f"Ошибка: {e}"
        )


