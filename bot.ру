)
def handle_text(message):

    chat_id = message.chat.id

    text = safe_text(
        message.text
    )

    print(
        f"[TEXT] {chat_id}: {text}"
    )

    if text == "🚗 Найти запчасть":

        enter_parts_mode(
            chat_id
        )

        return

    if text == "🛞 Шины и диски":

        enter_wheels_mode(
            chat_id
        )

        return

    if text == "🚘 В разборе":

        enter_donors_mode(
            chat_id
        )

        return

    if text == "❤️ Избранное":

        show_favorites(
            chat_id
        )

        return

    if text.startswith("/"):

        return

    perform_search(
        chat_id,
        text
    )


