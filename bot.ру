    )[:10]

    if not top:

        bot.send_message(
            message.chat.id,
            "Пользователей пока нет."
        )

        return

    text = (
        "🏆 Топ пользователей:\n\n"
    )

    for position, (
        user_id,
        data
    ) in enumerate(
        top,
        start=1
    ):

        if not isinstance(
            data,
            dict
        ):

            continue

        text += (
            f"{position}. ID: {user_id}\n"
            f"👁 Просмотров: "
            f"{data.get('views', 0)}\n"
            f"🔍 Поисков: "
            f"{data.get('searches', 0)}\n\n"
        )

    bot.send_message(
        message.chat.id,
        text
    )


