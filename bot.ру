# ============================================================

def find_donor_by_number(
    donor_number
):

    donor_number = safe_text(
        donor_number
    )

    if not donor_number:
        return None

    key = normalize(
        donor_number
    )

    with database_lock:

        donor = donors_index.get(
            key
        )

        if donor:
            return donor

        # Fallback.
        for item in donors_db:

            current_number = safe_text(
                item.get(
                    "Номер",
                    ""
                )
            )

            if normalize(
                current_number
            ) == key:

                return item

            current_number = safe_text(
                item.get(
                    "Номер донора",
                    ""
                )
            )

            if normalize(
                current_number
            ) == key:

                return item

    return None


