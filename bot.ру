)
def callback_open_donor(
    call
):

    safe_callback_answer(
        call
    )

    chat_id = (
        call.message.chat.id
    )

    donor_number = call.data[
        len("open_donor_"):
    ]

    if not donor_number:

        return

    # --------------------------------------------------------
    # Сохраняем текущую запчасть,
    # чтобы потом можно было вернуться.
    # --------------------------------------------------------

    old_mode = current_mode.get(
        chat_id
    )

    old_results = user_results.get(
        chat_id,
        []
    )

    old_index = user_index.get(
        chat_id,
        0
    )

    if (
        old_mode == "parts"
        and old_results
        and 0 <= old_index < len(old_results)
    ):

        user_donor_context[
            chat_id
        ] = {
            "mode": "parts",
            "results": old_results,
            "index": old_index
        }

    # --------------------------------------------------------
    # Ищем донора.
    # --------------------------------------------------------

    donor = find_donor_by_number(
        donor_number
    )

    if not donor:

        bot.send_message(
            chat_id,
            f"❌ Донор № {donor_number} "
            f"не найден в базе."
        )

        return

    # --------------------------------------------------------
    # Переключаемся в donors.
    # --------------------------------------------------------

    current_mode[
        chat_id
    ] = "donors"

    user_results[
        chat_id
    ] = [donor]

    user_index[
        chat_id
    ] = 0

    user_photo_index[
        chat_id
    ] = 0

    send_donor_card(
        chat_id,
