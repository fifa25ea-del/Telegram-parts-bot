def get_part_donor_number(
    part
):

    if not part:
        return ""

    # Основная колонка.
    if donor_key:

        value = safe_text(
            part.get(
                donor_key,
                ""
            )
        )

        if value:
            return value

    # Дополнительная защита.
    for key in [
        "Донор",
        "Номер донора",
        "№ донора",
        "Номер_донора",
        "Donor",
        "DonorNumber",
        "donor_id",
        "donorid"
    ]:

        value = safe_text(
            part.get(
                key,
                ""
            )
        )

        if value:
            return value

    return ""


