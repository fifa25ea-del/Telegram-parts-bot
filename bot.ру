def add_index_value(
    index,
    key,
    row
):

    if not key:
        return

    normalized = normalize_article(
        key
    )

    if not normalized:
        return

    # Не добавляем одну и ту же строку дважды
    if row not in index[normalized]:

        index[normalized].append(
            row
        )


def build_indexes(
    parts,
    wheels
):

    global parts_article_index
    global parts_number_index

    global wheels_article_index
    global wheels_brand_index
    global wheels_model_index
    global wheels_radius_index

    new_parts_article = defaultdict(list)
    new_parts_number = defaultdict(list)

    new_wheels_article = defaultdict(list)
    new_wheels_brand = defaultdict(list)
    new_wheels_model = defaultdict(list)
    new_wheels_radius = defaultdict(list)

    # --------------------------------------------------------
    # PARTS
    # --------------------------------------------------------

    for row in parts:

        article_values = [
            row.get("Артикул", ""),
            row.get("article", ""),
            row.get("Article", "")
        ]

        if number_key:

            article_values.append(
                row.get(
                    number_key,
                    ""
                )
            )

        for value in article_values:

            value = safe_text(
                value
            )

            if value:

                add_index_value(
                    new_parts_article,
                    value,
                    row
                )

        number_values = [
            row.get("Номер", ""),
            row.get("номер", ""),
            row.get("OEM", ""),
            row.get("oem", "")
        ]

        for value in number_values:

            value = safe_text(
                value
            )

            if value:

                add_index_value(
                    new_parts_number,
                    value,
                    row
                )

    # --------------------------------------------------------
    # WHEELS
    # --------------------------------------------------------

    for row in wheels:

        article = safe_text(
            row.get(
                "Артикул",
                ""
            )
        )

        if article:

            add_index_value(
                new_wheels_article,
                article,
                row
            )

        brand = safe_text(
            row.get(
                "Производитель диска",
                ""
            )
        )

        if brand:

            add_index_value(
                new_wheels_brand,
                brand,
                row
            )

        model = safe_text(
            row.get(
                "Модель диска",
                ""
            )
        )

        if model:

            add_index_value(
                new_wheels_model,
                model,
                row
            )

        radius = safe_text(
            row.get(
                "Диаметр диска",
                ""
            )
        )

        if radius:

            radius_normalized = normalize(
                radius
            )

            new_wheels_radius[
                radius_normalized
            ].append(
                row
            )

    parts_article_index = (
        new_parts_article
    )

    parts_number_index = (
        new_parts_number
    )

    wheels_article_index = (
        new_wheels_article
    )

    wheels_brand_index = (
        new_wheels_brand
    )

    wheels_model_index = (
        new_wheels_model
    )

    wheels_radius_index = (
        new_wheels_radius
    )

    print(
        "[INDEX] Индексы построены:"
    )

    print(
        f"[INDEX] parts articles: "
        f"{len(parts_article_index)}"
    )

    print(
        f"[INDEX] parts numbers: "
        f"{len(parts_number_index)}"
    )

    print(
        f"[INDEX] wheels articles: "
        f"{len(wheels_article_index)}"
    )

    print(
        f"[INDEX] wheels brands: "
        f"{len(wheels_brand_index)}"
    )

    print(
        f"[INDEX] wheels models: "
        f"{len(wheels_model_index)}"
    )

    print(
        f"[INDEX] wheels radius: "
        f"{len(wheels_radius_index)}"
    )


