def add_index_value(index, value, position):
    value = normalize(fix_a(value))

    if not value:
        return

    index[value].add(position)

    # Префиксы для быстрого поиска.
    for length in range(4, min(10, len(value)) + 1):
        index[value[:length]].add(position)


