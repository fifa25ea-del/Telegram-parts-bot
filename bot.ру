def find_wheels(query):
    query_normalized = normalize(fix_a(query))

    if not query_normalized:
        return []

    radius_query = query_normalized

    if radius_query.startswith("r"):
        radius_query = radius_query[1:]

    with database_lock:

        positions = set()

        if query_normalized in wheels_index:
            positions.update(
                wheels_index[query_normalized]
            )

        if len(query_normalized) >= 2:
            positions.update(
                wheels_index.get(
                    query_normalized[:2],
                    set()
                )
            )

        results = []

        for position in sorted(positions):

            if position >= len(wheels_db):
                continue

            item = wheels_db[position]

            radius = normalize(
                item.get(
                    "Диаметр диска",
                    ""
                )
            )

            brand = normalize(
                item.get(
                    "Производитель диска",
                    ""
                )
            )

            model = normalize(
                item.get(
                    "Модель диска",
                    ""
                )
            )

            article = normalize(
                item.get(
                    "Артикул",
                    ""
                )
            )

            pcd = normalize(
                item.get(
                    "PCD диска",
                    ""
                )
            )

            if (
                radius_query == radius
                or query_normalized in brand
                or query_normalized in model
                or query_normalized in article
                or query_normalized in pcd
            ):
                results.append(item)

            if len(results) >= MAX_RESULTS:
                break

        # Fallback.
        if not results:

            for item in wheels_db:

                values = [
                    item.get("Диаметр диска", ""),
                    item.get("Производитель диска", ""),
                    item.get("Модель диска", ""),
                    item.get("Артикул", ""),
                    item.get("PCD диска", "")
                ]

                normalized_values = [
                    normalize(fix_a(value))
                    for value in values
                ]

                if (
                    radius_query in normalized_values[0]
                    or any(
                        query_normalized in value
                        for value in normalized_values[1:]
                    )
                ):
                    results.append(item)

                if len(results) >= MAX_RESULTS:
                    break

        return results


