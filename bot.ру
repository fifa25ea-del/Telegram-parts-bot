@bot.message_handler(
    commands=["notfound"]
)
def not_found_cmd(message):

    if message.from_user.id != ADMIN_ID:
        return

    text = get_not_found()

    # Telegram ограничивает размер сообщения.
    max_length = 4000

    if len(text) <= max_length:

        bot.send_message(
            message.chat.id,
            text
        )

        return

    # Разбиваем длинный результат.
    for i in range(
        0,
        len(text),
        max_length
    ):

        bot.send_message(
            message.chat.id,
            text[i:i + max_length]
        )


