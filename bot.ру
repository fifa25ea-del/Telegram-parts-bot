def save_stats(data):

    try:
        with open(STATS_FILE, "w", encoding="utf-8") as f:
            json.dump(
                data,
                f,
                ensure_ascii=False,
                indent=2
            )

    except Exception as e:
        print("❌ Ошибка сохранения статистики:", e)


stats = load_stats()


def track(user_id, action):

    user_id = str(user_id)

    if user_id not in stats:

        stats[user_id] = {
            "searches": 0,
            "views": 0,
            "favorites": 0
        }

    if action not in stats[user_id]:
        stats[user_id][action] = 0

    stats[user_id][action] += 1

    save_stats(stats)


