@bot.callback_query_handler(
    func=lambda call: (
        call.data.startswith(
            "next_"
        )
        or
        call.data.startswith(
            "prev_"
        )
    )
)
def callback_navigation(
    call
):

    # Сразу отвечаем.
    safe_callback_answer(
        call
    )

    chat_id = (
        call.message.chat.id
    )

    results = user_results.get(
        chat_id,
        []
    )

    if not results:

        return

    current = user_index.get(
        chat_id,
        0
    )

    if call.data.startswith(
        "next_"
    ):

        current += 1

    else:

        current -= 1

    if (
        current
        >= len(results)
    ):

        current = 0

    if current < 0:

        current = (
            len(results)
            - 1
        )

    user_index[
        chat_id
    ] = current

    user_photo_index[
        chat_id
    ] = 0

    try:

        send_card(
            chat_id,
            current
        )

    except Exception as e:

        print(
            f"[NAVIGATION] "
            f"Ошибка: {e}"
        )


