def perform_search(
    chat_id,
    query
):

    query = safe_text(
        query
    )

    if len(query) < 2:

        bot.send_message(
            chat_id,
            "⚠️ Введите минимум 2 символа."
        )

        return

    mode = current_mode.get(
        chat_id,
        "parts"
    )

    track(
        chat_id,
        "searches"
    )

    # ----------------------------
    # PARTS
    # ----------------------------

    if mode == "parts":

        print(
            f"🔥 SEARCH PARTS: {query}"
        )

        log_search(
            chat_id,
            query,
            "parts"
        )

        results = find_part(
            query,
            parts_db
        )

        if not results:

            print(
                f"❌ NOT FOUND PARTS: {query}"
            )

            log_search(
                chat_id,
                query,
                "NOT_FOUND"
            )

            bot.send_message(
                chat_id,
                "❌ Ничего не найдено.\n"
                "Проверьте номер детали."
            )

            return

        user_results[chat_id] = results
        user_index[chat_id] = 0
        user_photo_index[chat_id] = 0

        send_part_card(
            chat_id,
            0
        )

        return

    # ----------------------------
    # WHEELS
    # ----------------------------

    if mode == "wheels":

        print(
            f"🔥 SEARCH WHEELS: {query}"
        )

        log_search(
            chat_id,
            query,
            "wheels"
        )

        results = find_wheels(
            query,
            wheels_db
        )

        if not results:

            print(
                f"❌ NOT FOUND WHEELS: {query}"
            )

            log_search(
                chat_id,
                query,
                "NOT_FOUND_WHEELS"
            )

            bot.send_message(
                chat_id,
                "❌ Ничего не найдено."
            )

            return

        user_results[chat_id] = results
        user_index[chat_id] = 0
        user_photo_index[chat_id] = 0

        send_wheels_preview(
            chat_id,
            results
        )

        return

    # ----------------------------
    # DONORS
    # ----------------------------

    if mode == "donors":

        bot.send_message(
            chat_id,
            "🚘 Для поиска запчастей "
            "выберите «🚗 Найти запчасть»."
        )

        return

    # ----------------------------
    # Если режим не выбран
    # ----------------------------

    bot.send_message(
        chat_id,
        "Выберите действие из меню.",
        reply_markup=main_menu()
    )


