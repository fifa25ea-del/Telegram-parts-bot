def safe_text(value):

    if value is None:
        return ""

    return str(value).strip()


def normalize(text):

    text = safe_text(
        text
    ).lower()

    replacements = {
        "а": "a",
        "в": "b",
        "с": "c",
        "е": "e",
        "н": "h",
        "к": "k",
        "м": "m",
        "о": "o",
        "р": "p",
        "т": "t",
        "х": "x",
        "у": "y",
    }

    for old, new in replacements.items():

        text = text.replace(
            old,
            new
        )

    text = re.sub(
        r"[\s\-_./\\]+",
        "",
        text
    )

    return text


def fix_a(text):

    return safe_text(
        text
    ).lower().replace(
        "а",
        "a"
    )


def first_photo(value):

    if not value:
        return None

    for photo in str(
        value
    ).split(","):

        photo = photo.strip()

        if (
            photo.startswith(
                "http://"
            )
            or
            photo.startswith(
                "https://"
            )
        ):
            return photo

    return None


def photo_list(value):

    if not value:
        return []

    result = []

    for photo in str(
        value
    ).split(","):

        photo = photo.strip()

        if (
            photo.startswith(
                "http://"
            )
            or
            photo.startswith(
                "https://"
            )
        ):
            result.append(
                photo
            )

    return result[:MAX_PHOTOS]


