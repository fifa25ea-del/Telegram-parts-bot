def send_photo_album(
    chat_id,
    photos,
    caption=None
):
    """
    Отправляет альбом.

    Фотографии сначала скачиваются самостоятельно,
    поэтому Telegram не должен выдавать
    failed to get HTTP URL content.
    """

    media = []

    for index, url in enumerate(
        photos[:MAX_PHOTOS]
    ):

        content = download_photo(
            url
        )

        if not content:
            continue

        if index == 0 and caption:

            media.append(
                types.InputMediaPhoto(
                    content,
                    caption=caption
                )
            )

        else:

            media.append(
                types.InputMediaPhoto(
                    content
                )
            )

    if not media:
        return []

    try:

        sent_messages = bot.send_media_group(
            chat_id,
            media
        )

        ids = [
            msg.message_id
            for msg in sent_messages
        ]

        user_album_msgs[chat_id] = ids

        return ids

    except Exception as e:

        print(
            f"[ALBUM] Ошибка: {e}"
        )

        return []


