def photo_cache_path(url):

    filename = hashlib.sha256(
        url.encode(
            "utf-8"
        )
    ).hexdigest()

    return os.path.join(
        PHOTO_CACHE_DIR,
        filename + ".jpg"
    )


def get_cached_photo(url):

    if not url:
        return None

    path = photo_cache_path(
        url
    )

    if not os.path.exists(path):
        return None

    try:

        with open(
            path,
            "rb"
        ) as f:

            return f.read()

    except Exception as e:

        print(
            f"[CACHE] read error: {e}"
        )

        return None


def save_cached_photo(
    url,
    content
):

    if not content:
        return

    path = photo_cache_path(
        url
    )

    temp_path = path + ".tmp"

    try:

        with photo_cache_lock:

            with open(
                temp_path,
                "wb"
            ) as f:

                f.write(
                    content
                )

            os.replace(
                temp_path,
                path
            )

    except Exception as e:

        print(
            f"[CACHE] write error: {e}"
        )

        try:

            if os.path.exists(
                temp_path
            ):
                os.remove(
                    temp_path
                )

        except Exception:
            pass


def download_photo(url):

    if not url:
        return None

    if not (
        url.startswith(
            "http://"
        )
        or url.startswith(
            "https://"
        )
    ):
        return None

    cached = get_cached_photo(
        url
    )

    if cached:
        return cached

    try:

        response = requests.get(
            url,
            headers=USER_AGENT,
            timeout=REQUEST_TIMEOUT
        )

        if response.status_code != 200:

            print(
                f"[PHOTO] HTTP "
                f"{response.status_code}: "
                f"{url}"
            )

            return None

        content = response.content

        if not content:
            return None

        # Защита от HTML вместо изображения.
        content_type = (
            response.headers.get(
                "Content-Type",
                ""
            ).lower()
        )

        if (
            "text/html"
            in content_type
        ):

            print(
                f"[PHOTO] HTML instead "
                f"of image: {url}"
            )

            return None

        save_cached_photo(
            url,
            content
        )

        return content

    except Exception as e:

        print(
            f"[PHOTO] Download error: "
            f"{e}"
        )

        return None


