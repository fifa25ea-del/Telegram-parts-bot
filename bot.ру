        return False

    if user_id not in favorites:

        favorites[user_id] = []

    if item_id in favorites[user_id]:

        return False

    favorites[user_id].append(
        item_id
    )

    save_favorites()

    track(
        chat_id,
        "favorites"
    )

    return True


def remove_favorite(
    chat_id,
    item_id
):

    user_id = str(
        chat_id
    )

    if user_id not in favorites:
        return False

    if item_id not in favorites[user_id]:
        return False

    favorites[user_id].remove(
        item_id
    )

    save_favorites()

    return True


def find_favorite_items(
    chat_id
):

    user_id = str(
        chat_id
    )

    ids = set(
        favorites.get(
            user_id,
            []
        )
    )

    if not ids:
        return []

    result = []

    with database_lock:

        for item in parts_db:

            item_id = get_item_id(
                item
            )

            if item_id in ids:

                result.append(
                    (
                        "parts",
                        item
                    )
                )

        for item in wheels_db:

            item_id = get_item_id(
                item
            )

            if item_id in ids:

                result.append(
                    (
                        "wheels",
                        item
                    )
                )

    return result


