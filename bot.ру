def _truncate_ai_text(
    text,
    max_length=3000
):

    text = safe_text(
        text
    )

    if not text:

        return ""

    # Убираем markdown-заголовки,
    # чтобы Telegram не показывал их сырой разметкой.
    text = re.sub(
        r"^\s*#{1,6}\s*",
        "",
        text,
        flags=re.MULTILINE
    )

    # Убираем жирный markdown.
    text = text.replace(
        "**",
        ""
    )

    # Убираем markdown-ссылки,
    # потому что ссылки будут отдельными кнопками.
    text = re.sub(
        r"\[([^\]]+)\]\((https?://[^)]+)\)",
        r"\1",
        text
    )

    text = text.strip()

    if len(text) > max_length:

        text = (
            text[:max_length - 3]
            + "..."
        )

    return text


def _extract_ai_sources(
    response
):

    sources = []

    seen = set()

    try:

        data = response.model_dump()

    except Exception:

        data = {}

    # --------------------------------------------------------
    # Источники из web_search_call.action.sources
    # --------------------------------------------------------

    for item in data.get(
        "output",
        []
    ):

        if not isinstance(
            item,
            dict
        ):

            continue

        if item.get(
            "type"
        ) != "web_search_call":

            continue

        action = item.get(
            "action"
        ) or {}

        raw_sources = action.get(
            "sources",
            []
        )

        if not isinstance(
            raw_sources,
            list
        ):

            continue

        for source in raw_sources:

            if not isinstance(
                source,
                dict
            ):

                continue

            url = safe_text(
                source.get(
                    "url",
                    ""
                )
            )

            if not url:

                continue

            if not url.startswith(
                (
                    "http://",
                    "https://"
                )
            ):

                continue

            if url in seen:

                continue

            seen.add(
                url
            )

            title = safe_text(
                source.get(
                    "title",
                    ""
                )
            )

            description = safe_text(
                source.get(
                    "description",
                    ""
                )
                or
                source.get(
                    "snippet",
                    ""
                )
            )

            sources.append(
                {
                    "title": (
                        title
                        or
                        web_domain(url)
                        or
                        "Источник"
                    ),
                    "url": url,
                    "description": description
                }
            )

    # --------------------------------------------------------
    # Если sources отсутствуют,
    # пробуем достать URL из annotations.
    # --------------------------------------------------------

    if not sources:

        for item in data.get(
            "output",
            []
        ):

            if not isinstance(
                item,
                dict
            ):

                continue

            if item.get(
                "type"
            ) != "message":

                continue

            for content in item.get(
                "content",
                []
            ):

                if not isinstance(
                    content,
                    dict
                ):

                    continue

                for annotation in content.get(
                    "annotations",
                    []
                ):

                    if not isinstance(
                        annotation,
                        dict
                    ):

                        continue

                    if annotation.get(
                        "type"
                    ) != "url_citation":

                        continue

                    citation = (
                        annotation.get(
                            "url_citation"
                        )
                        or
                        annotation
                    )

                    url = safe_text(
                        citation.get(
                            "url",
                            ""
                        )
                    )

                    if not url:

                        continue

                    if url in seen:

                        continue

                    seen.add(
                        url
                    )

                    title = safe_text(
                        citation.get(
                            "title",
                            ""
                        )
                    )

                    sources.append(
                        {
                            "title": (
                                title
                                or
                                web_domain(url)
                                or
                                "Источник"
                            ),
                            "url": url,
                            "description": ""
                        }
                    )

    return sources[
        :AI_WEB_MAX_SOURCES
    ]


def ai_web_search(
    original_query,
    prepared_query=None,
    max_results=5
):

    if not AI_WEB_ENABLED:
        return []

    original_query = safe_text(
        original_query
    )

    prepared_query = safe_text(
        prepared_query
    )

    if not original_query:
        return []

    if not prepared_query:
        prepared_query = original_query

    print(
        "🤖 AI WEB SEARCH — ECONOMY MODE"
    )

    print(
        f"[AI WEB] Query: {prepared_query}"
    )

    # ========================================================
    # 1. DDGS — дешёвый поиск
    # ========================================================

    try:

        from ddgs import DDGS

        search_results = []

        regions = web_region_candidates(
            prepared_query
        )

        for region in regions:

            try:

                with DDGS(
                    timeout=WEB_SEARCH_TIMEOUT
                ) as ddgs:

                    results = list(
                        ddgs.text(
                            prepared_query,
                            region=region,
                            safesearch="moderate",
                            max_results=max_results
                        )
                    )

                if results:

                    search_results.extend(
                        results
                    )

            except Exception as e:

                print(
                    f"[DDGS] ERROR "
                    f"{region}: {e}"
                )

        # ----------------------------------------------------
        # Убираем дубли
        # ----------------------------------------------------

        unique_results = []

        seen_urls = set()

        for item in search_results:

            if not isinstance(
                item,
                dict
            ):
                continue

            url = canonical_web_url(
                item.get(
                    "href",
                    ""
                )
            )

            if not url:
                continue

            if url in seen_urls:
                continue

            seen_urls.add(url)

            unique_results.append(
                {
                    "title": clean_web_text(
                        item.get(
                            "title",
                            ""
                        )
                    ),
                    "url": url,
                    "description": clean_web_text(
                        item.get(
                            "body",
                            ""
                        )
                    )
                }
            )

        # ----------------------------------------------------
        # Сортируем по релевантности
        # ----------------------------------------------------

        unique_results.sort(
            key=lambda item:
                web_result_score(
                    item,
                    prepared_query
                ),
            reverse=True
        )

        search_results = unique_results[
            :max_results
        ]

    except Exception as e:

        print(
            f"❌ [DDGS] ERROR: {e}"
        )

        return []

    if not search_results:

        print(
            "[DDGS] No results"
        )

        return []

    print(
        f"[DDGS] Found: "
        f"{len(search_results)}"
    )

    # ========================================================
    # 2. Формируем короткий контекст для AI
    # ========================================================

    context_parts = []

    for index, item in enumerate(
        search_results[:5],
        start=1
    ):

        title = safe_text(
            item.get("title")
        )

        description = safe_text(
            item.get("description")
        )

        url = safe_text(
            item.get("url")
        )

        if len(description) > 700:

            description = (
                description[:697]
                + "..."
            )

        context_parts.append(
            f"[{index}] {title}\n"
            f"{description}\n"
            f"URL: {url}"
        )

    context = "\n\n".join(
        context_parts
    )

    # ========================================================
    # 3. Очень короткий prompt
    # ========================================================

    prompt = f"""
Ответь на вопрос пользователя:

{original_query}

Используй только информацию ниже.

{context}

Правила:
- Ответ только на русском.
- Сначала сразу дай ответ.
- Максимум 2-3 коротких предложения.
- Не повторяй вопрос.
- Не придумывай данные.
- Если источники противоречат друг другу,
  укажи это кратко.
- Не вставляй URL.
"""

    # ========================================================
    # 4. AI — только суммаризация
    # ========================================================

    try:

        response = ai_client.chat.completions.create(

            model=AI_WEB_MODEL,

            messages=[
                {
                    "role": "system",
                    "content": (
                        "Ты автомобильный помощник. "
                        "Отвечай кратко, точно и по делу."
                    )
                },
                {
                    "role": "user",
                    "content": prompt
                }
            ],

            temperature=0.1,

            max_tokens=300
        )

        answer = safe_text(
            response.choices[0]
            .message
            .content
        )

    except Exception as e:

        print(
            f"❌ [AI WEB] API ERROR: "
            f"{repr(e)}"
        )

        # Если AI недоступен —
        # всё равно можем показать
        # найденный результат.

        answer = ""

    # ========================================================
    # 5. Ограничиваем ответ
    # ========================================================

    answer = clean_web_text(
        answer
    )

    answer = repair_web_mojibake(
        answer
    )

    if len(answer) > 700:

        answer = (
            answer[:697]
            + "..."
        )

    if not answer:

        answer = (
            search_results[0]
            .get(
                "description",
                ""
            )
        )

        answer = clean_web_text(
            answer
        )

    # ========================================================
    # 6. Результаты для Telegram
    # ========================================================

    results = []

    for item in search_results:

        results.append(
            {
                "title": safe_text(
                    item.get("title")
                ),
                "url": safe_text(
                    item.get("url")
                ),
                "description": safe_text(
                    item.get("description")
                )
            }
        )

    print(
        f"[AI WEB] Answer: "
        f"{answer[:200]}"
    )

    print(
        f"[AI WEB] Sources: "
        f"{len(results)}"
    )

    return results

