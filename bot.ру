def log_search(chat_id, query, mode):
    try:
        with open(
            LOG_FILE,
            "a",
            encoding="utf-8"
        ) as f:

            time = datetime.now().strftime(
                "%Y-%m-%d %H:%M:%S"
            )

            f.write(
                f"{time} | "
                f"{chat_id} | "
                f"{mode} | "
                f"{query}\n"
            )

    except Exception as e:
        print(
            "Ошибка логирования:",
            e
        )


def get_not_found():
    try:

        with open(
            LOG_FILE,
            "r",
            encoding="utf-8"
        ) as f:

            lines = f.readlines()

        data = defaultdict(list)

        for line in lines:

            parts = line.strip().split("|")

            if len(parts) < 4:
                continue

            mode = parts[2].strip()

            if mode != "NOT_FOUND":
                continue

            chat_id = parts[1].strip()
            query = parts[3].strip()

            if query:
                data[query].append(
                    chat_id
                )

        if not data:
            return "Нет ненайденных запросов 👍"

        text = (
            "❌ Ничего не найдено:\n\n"
        )

        for query, users in data.items():

            unique_users = list(
                dict.fromkeys(users)
            )

            text += (
                f"🔍 {query}\n"
            )

            text += (
                f"👤 ID: "
                f"{', '.join(unique_users)}\n"
            )

            text += (
                f"📊 Запросов: "
                f"{len(users)}\n\n"
            )

        return text

    except FileNotFoundError:
        return "Логов пока нет."

    except Exception as e:
        return f"Ошибка: {e}"


