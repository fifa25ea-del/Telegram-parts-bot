def find_part(
    query
):

    query_normalized = (
        normalize_article(
            query
        )
    )

    if not query_normalized:

        return []

    results = []

    # --------------------------------------------------------
    # Сначала индекс.
    # --------------------------------------------------------

    with database_lock:

        exact = []

        # Точное совпадение артикула
        exact.extend(
            parts_article_index.get(
                query_normalized,
                []
            )
        )

        # Точное совпадение номера
        exact.extend(
            parts_number_index.get(
                query_normalized,
                []
            )
        )

        if exact:

            unique = []

            seen = set()

            for item in exact:

                item_id = id(
                    item
                )

                if item_id in seen:
                    continue

                seen.add(
                    item_id
                )

                unique.append(
                    item
                )

                if (
                    len(unique)
                    >= MAX_RESULTS
                ):

                    break

            return unique

        current_parts = list(
            parts_db
        )

    # --------------------------------------------------------
    # Если точного совпадения нет,
    # делаем fallback-поиск.
    #
    # Это уже не обычный путь артикула.
    # --------------------------------------------------------

    for part in current_parts:

        values = []

        if number_key:

            values.append(
                part.get(
                    number_key,
                    ""
                )
            )

        values.extend([
            part.get(
                "Артикул",
                ""
            ),
            part.get(
                "Номер",
                ""
            )
        ])

        found = False

        for value in values:

            value_normalized = (
                normalize_article(
                    value
                )
            )

            if not value_normalized:

                continue

            if (
                query_normalized
                in value_normalized
            ):

                found = True

                break

        if found:

            results.append(
                part
            )

        if (
            len(results)
            >= MAX_RESULTS
        ):

            break

    return results


# ============================================================
# SEARCH — WHEELS
# ============================================================

def find_wheels(
    query
):

    original = safe_text(
        query
    )

    normalized_query = normalize(
        original
    )

    if not normalized_query:

        return []

    radius_query = normalized_query

    if radius_query.startswith("r"):

        radius_query = (
            radius_query[1:]
        )

    with database_lock:

        # ----------------------------------------------------
        # R18 / 18
        # ----------------------------------------------------

        if (
            radius_query
            in wheels_radius_index
        ):

            return (
                wheels_radius_index[
                    radius_query
                ][:MAX_RESULTS]
            )

        # ----------------------------------------------------
        # Артикул
        # ----------------------------------------------------

        article_key = normalize_article(
            original
        )

        if (
            article_key
            in wheels_article_index
        ):

            return (
                wheels_article_index[
                    article_key
                ][:MAX_RESULTS]
            )

        # ----------------------------------------------------
        # Производитель / модель
        # ----------------------------------------------------

        brand_results = []

        model_results = []

        for key, rows in (
            wheels_brand_index.items()
        ):

            if (
                normalized_query
                in key
            ):

                brand_results.extend(
                    rows
                )

        for key, rows in (
            wheels_model_index.items()
        ):

            if (
                normalized_query
                in key
            ):

                model_results.extend(
                    rows
                )

        results = (
            brand_results
            + model_results
        )

        unique = []

        seen = set()

        for item in results:

            item_id = id(
                item
            )

            if item_id in seen:
                continue

            seen.add(
                item_id
            )

            unique.append(
                item
            )

            if (
                len(unique)
                >= MAX_RESULTS
            ):

                break

        return unique


