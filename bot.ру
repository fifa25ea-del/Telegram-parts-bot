def cleanup_photo_cache():

    try:

        files = []

        total_size = 0

        for filename in os.listdir(
            PHOTO_CACHE_DIR
        ):

            path = os.path.join(
                PHOTO_CACHE_DIR,
                filename
            )

            if not os.path.isfile(
                path
            ):
                continue

            try:

                stat = os.stat(
                    path
                )

                files.append(
                    (
                        path,
                        stat.st_mtime,
                        stat.st_size
                    )
                )

                total_size += (
                    stat.st_size
                )

            except Exception:
                continue

        max_bytes = (
            PHOTO_CACHE_MAX_MB
            * 1024
            * 1024
        )

        if total_size <= max_bytes:

            return

        # Старые файлы удаляем первыми.
        files.sort(
            key=lambda x: x[1]
        )

        deleted = 0

        for (
            path,
            _mtime,
            size
        ) in files:

            if total_size <= max_bytes:
                break

            try:

                os.remove(
                    path
                )

                total_size -= size

                deleted += 1

            except Exception:
                pass

        print(
            f"[CACHE] Deleted "
            f"{deleted} old photos"
        )

    except Exception as e:

        print(
            f"[CACHE] Cleanup error: "
            f"{e}"
        )


