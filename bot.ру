    user_id,
    action
):

    user_id = str(
        user_id
    )

    with stats_lock:

        if user_id not in stats:

            stats[user_id] = {
                "searches": 0,
                "views": 0,
                "favorites": 0
            }

        if (
            action
            not in stats[user_id]
        ):

            stats[user_id][action] = 0

        stats[user_id][action] += 1

    save_stats()


