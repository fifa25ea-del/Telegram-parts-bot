def ensure_photo_cache_dir():

    try:

        os.makedirs(
            PHOTO_CACHE_DIR,
            exist_ok=True
        )

    except Exception as e:

        print(
            f"[PHOTO CACHE] Не удалось создать папку: {e}"
        )


def photo_cache_path(url):

    digest = hashlib.sha256(
        url.encode(
            "utf-8",
            errors="ignore"
        )
    ).hexdigest()

    # Попробуем сохранить расширение
    clean_url = url.lower().split("?")[0]

    extension = ".jpg"

    for ext in (
        ".jpg",
        ".jpeg",
        ".png",
        ".webp"
    ):

        if clean_url.endswith(ext):

            extension = ext

            break

    return os.path.join(
        PHOTO_CACHE_DIR,
        digest + extension
    )


def is_bad_photo_cached(url):

    now = time.time()

    with photo_cache_lock:

        timestamp = bad_photo_cache.get(
            url
        )

        if not timestamp:
            return False

        if (
            now - timestamp
            > BAD_PHOTO_CACHE_SECONDS
        ):

            bad_photo_cache.pop(
                url,
                None
            )

            return False

        return True


def mark_bad_photo(url):

    with photo_cache_lock:

        bad_photo_cache[url] = time.time()


def clear_old_photo_cache():

    ensure_photo_cache_dir()

    now = time.time()

    max_age = (
        PHOTO_CACHE_DAYS
        * 24
        * 60
        * 60
    )

    try:

        for filename in os.listdir(
            PHOTO_CACHE_DIR
        ):

            path = os.path.join(
                PHOTO_CACHE_DIR,
                filename
            )

            try:

                mtime = os.path.getmtime(
                    path
                )

                if (
                    now - mtime
                    > max_age
                ):

                    os.remove(
                        path
                    )

            except Exception:
                pass

    except Exception as e:

        print(
            f"[PHOTO CACHE] Cleanup error: {e}"
        )


def download_photo(url):
    """
    Скачивание фото с дисковым кэшем.

    Telegram никогда не получает URL.
    Он получает уже загруженный файл.
    """

    if not url:
        return None

    if not (
        url.startswith("http://")
        or url.startswith("https://")
    ):
        return None

    ensure_photo_cache_dir()

    if is_bad_photo_cached(url):

        print(
            f"[PHOTO] Временно пропускаем плохой URL: {url}"
        )

        return None

    cache_path = photo_cache_path(
        url
    )

    # --------------------------------------------------------
    # Кэш
    # --------------------------------------------------------

    with photo_cache_lock:

        if os.path.exists(
            cache_path
        ):

            try:

                with open(
                    cache_path,
                    "rb"
                ) as f:

                    data = f.read()

                if data:

                    # Обновляем время файла
                    try:
                        os.utime(
                            cache_path,
                            None
                        )
                    except Exception:
                        pass

                    return data

            except Exception as e:

                print(
                    f"[PHOTO CACHE] "
                    f"Ошибка чтения {cache_path}: {e}"
                )

    # --------------------------------------------------------
    # Скачивание
    # --------------------------------------------------------

    try:

        print(
            f"[PHOTO] DOWNLOAD: {url}"
        )

        response = requests.get(
            url,
            headers=USER_AGENT,
            timeout=PHOTO_TIMEOUT,
            allow_redirects=True
        )

        if response.status_code != 200:

            print(
                f"[PHOTO] HTTP "
                f"{response.status_code}: "
                f"{url}"
            )

            mark_bad_photo(
                url
            )

            return None

        content = response.content

        if not content:

            mark_bad_photo(
                url
            )

            return None

        # Проверяем, что это действительно изображение.
        content_type = (
            response.headers
            .get(
                "Content-Type",
                ""
            )
            .lower()
        )

        if (
            content_type
            and not content_type.startswith(
                "image/"
            )
        ):

            # Некоторые серверы неправильно ставят Content-Type.
            # Поэтому полностью блокируем только явный HTML.
            beginning = content[:100].lower()

            if (
                b"<html" in beginning
                or b"<!doctype" in beginning
            ):

                print(
                    f"[PHOTO] Сервер вернул HTML: {url}"
                )

                mark_bad_photo(
                    url
                )

                return None

        # ----------------------------------------------------
        # Записываем кэш атомарно
        # ----------------------------------------------------

        temp_path = (
            cache_path
            + ".tmp"
        )

        try:

            with open(
                temp_path,
                "wb"
            ) as f:

                f.write(
                    content
                )

            os.replace(
                temp_path,
                cache_path
            )

        except Exception as e:

            print(
                f"[PHOTO CACHE] "
                f"Ошибка записи: {e}"
            )

            try:

                if os.path.exists(
                    temp_path
                ):
                    os.remove(
                        temp_path
                    )

            except Exception:
                pass

        return content

    except Exception as e:

        print(
            f"[PHOTO] Ошибка "
            f"{url}: {e}"
        )

        mark_bad_photo(
            url
        )

        return None


