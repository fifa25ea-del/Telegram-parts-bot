def load_csv(url):
    try:
        print("[CSV] Loading:", url)

        response = requests.get(
            url,
            headers=USER_AGENT,
            timeout=CSV_TIMEOUT
        )

        response.raise_for_status()

        content = response.content

        try:
            text = content.decode("utf-8-sig")
        except UnicodeDecodeError:
            text = content.decode(
                "cp1251",
                errors="replace"
            )

        text = text.lstrip("\ufeff")

        sample = text[:10000]
        delimiter = ";"

        try:
            dialect = csv.Sniffer().sniff(
                sample,
                delimiters=";,|\t"
            )
            delimiter = dialect.delimiter
        except Exception:
            pass

        reader = csv.DictReader(
            io.StringIO(text),
            delimiter=delimiter
        )

        rows = list(reader)
        headers = reader.fieldnames or []

        # Убираем None keys, которые иногда появляются
        # из-за некорректных строк CSV.
        clean_rows = []

        for row in rows:
            clean_row = {}

            for key, value in row.items():
                if key is None:
                    continue

                clean_row[str(key).strip()] = (
                    safe_text(value)
                )

            clean_rows.append(clean_row)

        print(
            f"[CSV] Loaded {len(clean_rows)} rows"
        )

        return clean_rows, headers

    except Exception as e:
        print("[CSV ERROR]", e)
        return [], []


def find_column(headers, variants):
    if not headers:
        return None

    normalized = {
        normalize(header): header
        for header in headers
    }

    normalized_variants = [
        normalize(v)
        for v in variants
    ]

    # Сначала точное совпадение.
    for variant in normalized_variants:
        if variant in normalized:
            return normalized[variant]

    # Потом частичное.
    for variant in normalized_variants:
        for key, original in normalized.items():
            if variant in key or key in variant:
                return original

    return None


