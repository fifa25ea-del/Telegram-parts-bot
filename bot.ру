def load_json_file(
    filename,
    default
):

    try:

        if not os.path.exists(
            filename
        ):
            return default

        with open(
            filename,
            "r",
            encoding="utf-8"
        ) as f:

            data = json.load(f)

        return data

    except Exception as e:

        print(
            f"[JSON] Ошибка {filename}: {e}"
        )

        return default


def save_json_file(
    filename,
    data
):

    try:

        temp_file = filename + ".tmp"

        with open(
            temp_file,
            "w",
            encoding="utf-8"
        ) as f:

            json.dump(
                data,
                f,
                ensure_ascii=False,
                indent=2
            )

        os.replace(
            temp_file,
            filename
        )

    except Exception as e:

        print(
            f"[JSON] Ошибка сохранения "
            f"{filename}: {e}"
        )


