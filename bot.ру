def web_result_score(
    result,
    query
):
    """
    Оценивает релевантность результата поиска.
    """

    title = safe_text(
        result.get("title")
    ).lower()

    body = safe_text(
        result.get("body")
    ).lower()

    url = safe_text(
        result.get("href")
        or result.get("url")
    ).lower()

    query = safe_text(
        query
    ).lower()

    score = 0

    # --------------------------------------------------------
    # Полный запрос
    # --------------------------------------------------------

    if query and query in title:
        score += 30

    if query and query in body:
        score += 12

    # --------------------------------------------------------
    # Отдельные слова
    # --------------------------------------------------------

    tokens = web_tokens(
        query
    )

    for token in set(tokens):

        if len(token) < 3:
            continue

        if token in title:
            score += 7

        elif token in body:
            score += 3

        if token in url:
            score += 1

    # --------------------------------------------------------
    # PDF
    # --------------------------------------------------------

    if url.split("?")[0].endswith(".pdf"):
        score += 4

    # --------------------------------------------------------
    # Официальные / технические домены
    # --------------------------------------------------------

    trusted_domains = (
        "mercedes-benz.com",
        "mercedes-benz.de",
        "bosch.com",
        "zf.com",
        "continental.com",
        "bilstein.com",
        "mahle.com",
        "hella.com",
        "schaeffler.com",
        "ngk.com",
        "febi.com",
    )

    domain = web_domain(
        url
    )

    if any(
        domain == item
        or domain.endswith(
            "." + item
        )
        for item in trusted_domains
    ):

        score += 6

    return score




