@bot.callback_query_handler(
    func=lambda call:
        (
            call.data.startswith("next_")
            or
            call.data.startswith("prev_")
        )
)
def callback_navigation(call):
    chat_id = call.message.chat.id

    results = user_results.get(
        chat_id,
        []
    )

    if not results:
        safe_callback_answer(
            call,
            "⚠️ Результаты уже недоступны.",
            True
        )

        return

    if current_mode.get(
        chat_id
    ) == "ai":
        safe_callback_answer(
            call
        )

        return

    # --------------------------------------------------------
    # Проверяем индекс, который был у кнопки.
    # Это защищает от старых callback.
    # --------------------------------------------------------

    try:
        callback_index = int(
            call.data.split(
                "_",
                1
            )[1]
        )

    except Exception:
        safe_callback_answer(
            call,
            "❌ Ошибка",
            True
        )

        return

    current = user_index.get(
        chat_id,
        0
    )

    if callback_index != current:
        safe_callback_answer(
            call,
            "⚠️ Эта кнопка уже устарела.",
            True
        )

        return

    if call.data.startswith(
        "next_"
    ):
        current += 1

    else:
        current -= 1

    if current >= len(results):
        current = 0

    if current < 0:
        current = len(results) - 1

    user_index[
        chat_id
    ] = current

    user_photo_index[
        chat_id
    ] = 0

    safe_callback_answer(
        call
    )

    try:
        send_card(
            chat_id,
            current
        )

    except Exception as e:
        print(
            f"[NAVIGATION] {e}"
        )


