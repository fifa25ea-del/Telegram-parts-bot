def get_item_id(
    item,
    fallback=""
):

    article = safe_text(
        item.get("Артикул")
    )

    if article:
        return article

    number = safe_text(
        item.get("Номер")
    )

    if number:
        return number

    return fallback


def is_favorite(
    chat_id,
    item
):

    user_id = str(chat_id)

    item_id = get_item_id(
        item
    )

    with favorites_lock:

        return item_id in favorites.get(
            user_id,
            []
        )


def add_favorite(
    chat_id,
    item
):

    user_id = str(chat_id)

    item_id = get_item_id(
        item
    )

    if not item_id:
        return False

    with favorites_lock:

        if user_id not in favorites:
            favorites[user_id] = []

        if item_id in favorites[user_id]:
            return False

        favorites[user_id].append(
            item_id
        )

        save_favorites()

    track(
        chat_id,
        "favorites"
    )

    return True


def remove_favorite(
    chat_id,
    item_id
):

    user_id = str(chat_id)

    with favorites_lock:

        if user_id not in favorites:
            return False

        if item_id not in favorites[user_id]:
            return False

        favorites[user_id].remove(
            item_id
        )

        save_favorites()

        return True


