        load_csv(
            WHEELS_CSV
        )
    )

    # Если какая-то база полностью не загрузилась,
    # считаем обновление неуспешным.
    if not new_donors:
        raise RuntimeError(
            "CSV доноров пуст или не загрузился."
        )

    if not new_parts:
        raise RuntimeError(
            "CSV запчастей пуст или не загрузился."
        )

    if not new_wheels:
        raise RuntimeError(
            "CSV дисков пуст или не загрузился."
        )

    # Свежие записи сверху.
    new_donors.reverse()
    new_parts.reverse()

    # --------------------------------------------------------
    # Определяем колонки ДО публикации новой базы.
    # --------------------------------------------------------

    new_number_key = find_column(
        part_headers,
        [
            "артикул",
            "номер",
            "article",
            "partnumber",
            "part_number"
        ]
    )

    new_name_key = find_column(
        part_headers,
        [
            "наименование",
            "название",
            "наимен",
            "name"
        ]
    )

    new_photo_key = find_column(
        part_headers,
        [
            "фото",
            "фотографии",
            "image",
            "images",
            "photo"
        ]
    )

    # --------------------------------------------------------
    # Строим индексы на локальных данных.
    # --------------------------------------------------------

    global_temp_number_key = (
        number_key
    )

    number_key = new_number_key

    build_indexes(
        new_parts,
        new_wheels
    )

    # --------------------------------------------------------
    # Публикуем новую базу атомарно.
    # --------------------------------------------------------

    with database_lock:

        donors_db = new_donors
        parts_db = new_parts
        wheels_db = new_wheels

        number_key = new_number_key
        name_key = new_name_key
        photo_key = new_photo_key

    print(
        "=" * 70
    )

    print(
        "БАЗЫ ЗАГРУЖЕНЫ"
    )

    print(
        f"Доноров: {len(donors_db)}"
    )

    print(
        f"Запчастей: {len(parts_db)}"
    )

    print(
        f"Дисков: {len(wheels_db)}"
    )

    print(
        f"number_key: {number_key}"
    )

    print(
        f"name_key: {name_key}"
