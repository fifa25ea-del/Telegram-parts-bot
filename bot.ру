def load_csv(url):
    """
    Загружает CSV.
    """

    try:
        print(f"[CSV] Загружаю: {url}")

        response = requests.get(
            url,
            headers=USER_AGENT,
            timeout=60
        )

        response.raise_for_status()

        # Пробуем определить кодировку.
        response.encoding = "cp1251"

        text = response.text

        # Удаляем BOM.
        text = text.lstrip("\ufeff")

        csv_file = io.StringIO(text)

        reader = csv.DictReader(
            csv_file,
            delimiter=";"
        )

        rows = list(reader)

        print(
            f"[CSV] Загружено: {len(rows)} строк"
        )

        return rows, reader.fieldnames or []

    except Exception as e:
        print(f"[CSV] ОШИБКА: {e}")

        return [], []


def find_column(headers, variants):
    """
    Ищет колонку по нескольким вариантам.
    """

    if not headers:
        return None

    normalized = {}

    for header in headers:
        normalized[normalize(header)] = header

    for variant in variants:
        variant_normalized = normalize(variant)

        for key, original in normalized.items():
            if variant_normalized in key:
                return original

    return None


