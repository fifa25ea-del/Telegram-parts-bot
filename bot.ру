def polling_error_handler():

    while True:

        try:

            print("=" * 70)
            print(
                "🚀 Telegram polling запускается..."
            )
            print("=" * 70)

            bot.infinity_polling(
                timeout=30,
                long_polling_timeout=30,
                skip_pending=True,
                allowed_updates=[
                    "message",
                    "callback_query"
                ]
            )

        except KeyboardInterrupt:

            print(
                "🛑 Остановка бота."
            )

            break

        except Exception as e:

            print("=" * 70)
            print(
                "❌ POLLING ERROR"
            )
            print(
                repr(e)
            )
            print("=" * 70)

            time.sleep(5)


