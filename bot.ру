def web_mojibake_score(text):

    text = safe_text(text)

    if not text:
        return 0

    score = 0

    patterns = (
        "Рђ", "Р‘", "Р’", "Р“", "Р”",
        "Р•", "Р–", "Р—", "Р°", "Р±",
        "РІ", "Рі", "Рґ", "Рµ", "Р¶",
        "Р·", "Рё", "Р№", "Рє", "Рљ",
        "Р»", "Рј", "РЅ", "Рѕ", "Рї",
        "РЎ", "Рџ", "С‚", "СЊ",
        "Ð", "Ñ", "â",
        "пїЅ", "п╨", "п╬", "п²",
        "п©", "п╫", "п╩", "п▒",
        "я┐", "я│", "я┌", "я─",
        "а", "а", "а", "а",
        "а", "а", "а", "а",
        "а", "а", "а", "а",
        "а", "а", "а", "а",
        "б", "б", "б", "б",
        "б", "б", "б", "б",
        "б", "б", "б", "б",
        "б", "б", "б", "б",
    )

    for pattern in patterns:

        score += text.count(pattern)

    score += len(
        re.findall(
            r"(?:Р.|С.|Ð.|Ñ.|а.|б.|п.|я.){3,}",
            text
        )
    ) * 3

    return score


# ============================================================
# SPECIAL MOJIBAKE
#
# Исправляет строки вида:
#
# ааОаВаОббаИ
# аКаЛаАббаА
# п²п╬п╡п╬я│я┌п╦
#
# которые обычный cp1251/latin-1 repair не ловит.
# ============================================================

def repair_web_special_mojibake(text):

    text = safe_text(text)

    if not text:
        return ""

    original = text

    candidates = []

    # --------------------------------------------------------
    # Кандидат 1:
    #
    # В некоторых случаях последовательность
    # является результатом повторного преобразования
    # UTF-8/CP1251.
    # --------------------------------------------------------

    encodings = (
        "cp1251",
        "latin-1",
        "cp866",
        "koi8-r",
    )

    decodings = (
        "utf-8",
        "cp1251",
        "cp866",
        "koi8-r",
        "latin-1",
    )

    for encoding_a in encodings:

        for encoding_b in decodings:

            try:

                candidate = (
                    text
                    .encode(
                        encoding_a,
                        errors="strict"
                    )
                    .decode(
                        encoding_b,
                        errors="strict"
                    )
                )

                if candidate != text:

                    candidates.append(
                        candidate
                    )

            except Exception:
                continue

    # --------------------------------------------------------
    # Кандидат 2:
    #
    # Пытаемся восстановить строку через
    # обратную последовательность кодировок.
    # --------------------------------------------------------

    for encoding_a in (
        "utf-8",
        "cp1251",
        "cp866",
        "latin-1",
    ):

        for encoding_b in (
            "utf-8",
            "cp1251",
            "cp866",
            "latin-1",
        ):

            try:

                intermediate = text.encode(
                    encoding_a,
                    errors="ignore"
                )

                candidate = intermediate.decode(
                    encoding_b,
                    errors="ignore"
                )

                if candidate != text:

                    candidates.append(
                        candidate
                    )

            except Exception:
                continue

    # --------------------------------------------------------
    # Оценка.
    # --------------------------------------------------------

    def score(value):

        value = safe_text(value)

        if not value:
            return 10**9

        bad = web_mojibake_score(
            value
        )

        replacement = value.count(
            "\ufffd"
        )

        # Символы, характерные для
        # п╨ / я┐ / аО / б и т.п.
        weird = len(
            re.findall(
                r"[╔╚╠╦╩╬╭╮╯╰╱╲╳"
                r"╴╵╶╷╸╹╺╻╼╽╾╿"
                r"┐└┘├┤┬┴│─]",
                value
            )
        )

        cyr = len(
            re.findall(
                r"[А-Яа-яЁё]",
                value
            )
        )

        latin = len(
            re.findall(
                r"[A-Za-z0-9]",
                value
            )
        )

        return (
            bad * 100
            + replacement * 5000
            + weird * 100
            - min(cyr, 20000) * 2
            - min(latin, 5000) * 0.1
        )

    best = original
    best_score = score(
        original
    )

    for candidate in candidates:

        candidate = safe_text(
            candidate
        )

        if not candidate:
            continue

        candidate_score = score(
            candidate
        )

        if candidate_score < best_score:

            best = candidate
            best_score = candidate_score

    return best


# ============================================================
# TRY REPAIR MOJIBAKE
# ============================================================

def repair_web_mojibake(text):

    text = safe_text(text)

    if not text:
        return ""

    original = text

    candidates = []

    # --------------------------------------------------------
    # 1. UTF-8 -> CP1251 -> UTF-8
    # --------------------------------------------------------

    try:

        candidates.append(
            text
            .encode("cp1251")
            .decode("utf-8")
        )

    except Exception:
        pass

    # --------------------------------------------------------
    # 2. UTF-8 -> Latin-1 -> UTF-8
    # --------------------------------------------------------

    try:

        candidates.append(
            text
            .encode("latin-1")
            .decode("utf-8")
        )

    except Exception:
        pass

    # --------------------------------------------------------
    # 3. UTF-8 -> CP866 -> UTF-8
    # --------------------------------------------------------

    try:

        candidates.append(
            text
            .encode("cp866")
            .decode("utf-8")
        )

    except Exception:
        pass

    # --------------------------------------------------------
    # 4. Несколько комбинаций.
    # --------------------------------------------------------

    for encoding_a in (
        "cp1251",
        "latin-1",
        "cp866",
        "koi8-r",
    ):

        for encoding_b in (
            "utf-8",
            "cp1251",
            "cp866",
            "koi8-r",
            "latin-1",
        ):

            try:

                repaired = (
                    text
                    .encode(
                        encoding_a
                    )
                    .decode(
                        encoding_b
                    )
                )

                if repaired != text:

                    candidates.append(
                        repaired
                    )

            except Exception:
                continue

    # --------------------------------------------------------
    # 5. Специальный repair.
    # --------------------------------------------------------

    special = repair_web_special_mojibake(
        text
    )

    if special != text:

        candidates.append(
            special
        )

    # --------------------------------------------------------
    # Оценка кандидатов.
    # --------------------------------------------------------

    def score(value):

        value = safe_text(
            value
        )

        if not value:
            return 10**9

        mojibake = web_mojibake_score(
            value
        )

        replacement = value.count(
            "\ufffd"
        )

        weird = len(
            re.findall(
                r"[╔╚╠╦╩╬╭╮╯╰╱╲╳"
                r"╴╵╶╷╸╹╺╻╼╽╾╿"
                r"┐└┘├┤┬┴│─]",
                value
            )
        )

        cyr = len(
            re.findall(
                r"[А-Яа-яЁё]",
                value
            )
        )

        latin = len(
            re.findall(
                r"[A-Za-z0-9]",
                value
            )
        )

        return (
            mojibake * 100
            + replacement * 5000
            + weird * 100
            - min(cyr, 20000) * 2
            - min(latin, 5000) * 0.1
        )

    best = original

    best_score = score(
        original
    )

    for candidate in candidates:

        candidate = safe_text(
            candidate
        )

        if not candidate:
            continue

        candidate_score = score(
            candidate
        )

        if candidate_score < best_score:

            best = candidate
            best_score = candidate_score

    # --------------------------------------------------------
    # Если всё ещё явно битое —
    # пробуем специальный repair ещё раз.
    # --------------------------------------------------------

    if web_mojibake_score(best) > 5:

        second = repair_web_special_mojibake(
            best
        )

        if score(second) < best_score:

            best = second
            best_score = score(
                second
            )

    if best != original:

        print(
            "[WEB ENCODING] "
            "Mojibake repaired"
        )

        print(
            f"[WEB ENCODING] "
            f"before={original[:160]}"
        )

        print(
            f"[WEB ENCODING] "
            f"after={best[:160]}"
        )

    return best


# ============================================================
# WEB RESPONSE DECODING
# ============================================================

def decode_web_response(response):

    raw = response.content

    if not raw:
        return ""

    # --------------------------------------------------------
    # BOM
    # --------------------------------------------------------

    if raw.startswith(b"\xef\xbb\xbf"):

        try:

            text = raw.decode(
                "utf-8-sig",
                errors="strict"
            )

            return repair_web_mojibake(
                text
            )

        except Exception:
            pass

    if raw.startswith(b"\xff\xfe"):

        try:

            text = raw.decode(
                "utf-16",
                errors="strict"
            )

            return repair_web_mojibake(
                text
            )

        except Exception:
            pass

    if raw.startswith(b"\xfe\xff"):

        try:

            text = raw.decode(
                "utf-16-be",
                errors="strict"
            )

            return repair_web_mojibake(
                text
            )

        except Exception:
            pass

    # --------------------------------------------------------
    # Собираем кандидаты.
    # --------------------------------------------------------

    candidates = []

    # UTF-8.
    try:

        candidates.append(
            (
                "utf-8",
                raw.decode(
                    "utf-8",
                    errors="strict"
                )
            )
        )

    except UnicodeDecodeError:
        pass

    # HTTP charset.
    content_type = safe_text(
        response.headers.get(
            "Content-Type",
            ""
        )
    )

    match = re.search(
        r"charset\s*=\s*['\"]?([^;\s'\"]+)",
        content_type,
        re.IGNORECASE
    )

    if match:

        candidates.append(
            (
                match.group(1),
                raw.decode(
                    match.group(1),
                    errors="replace"
                )
            )
        )

    # --------------------------------------------------------
    # Charset из HTML.
    # --------------------------------------------------------

    try:

        head = raw[:100000].decode(
            "latin-1",
            errors="ignore"
        )

        match = re.search(
            r'<meta[^>]+charset\s*=\s*'
            r'["\']?\s*([a-zA-Z0-9._-]+)',
            head,
            re.IGNORECASE
        )

        if match:

            encoding = match.group(1)

            candidates.append(
                (
                    encoding,
                    raw.decode(
                        encoding,
                        errors="replace"
                    )
                )
            )

        match = re.search(
            r'content=["\'][^"\']*charset='
            r'([a-zA-Z0-9._-]+)',
            head,
            re.IGNORECASE
        )

        if match:

            encoding = match.group(1)

            candidates.append(
                (
                    encoding,
                    raw.decode(
                        encoding,
                        errors="replace"
                    )
                )
            )

    except Exception:
        pass

    # --------------------------------------------------------
    # Русские старые кодировки.
    # --------------------------------------------------------

    for encoding in (
        "cp1251",
        "windows-1251",
        "koi8-r",
        "iso-8859-5",
        "cp866",
        "latin-1",
    ):

        try:

            candidates.append(
                (
                    encoding,
                    raw.decode(
                        encoding,
                        errors="replace"
                    )
                )
            )

        except Exception:
            continue

    # --------------------------------------------------------
    # requests apparent encoding.
    # --------------------------------------------------------

    try:

        apparent = (
            response.apparent_encoding
        )

        if apparent:

            candidates.append(
                (
                    apparent,
                    raw.decode(
                        apparent,
                        errors="replace"
                    )
                )
            )

    except Exception:
        pass

    # --------------------------------------------------------
    # Убираем дубли.
    # --------------------------------------------------------

    unique = []

    seen = set()

    for encoding, text in candidates:

        key = (
            safe_text(encoding)
            .lower()
        )

        if not key:
            continue

        if key in seen:
            continue

        seen.add(
            key
        )

        unique.append(
            (
                key,
                text
            )
        )

    # --------------------------------------------------------
    # Оценка.
    # --------------------------------------------------------

    best_text = ""
    best_score = None
    best_encoding = ""

    for encoding, text in unique:

        replacement_count = (
            text.count("\ufffd")
        )

        mojibake = (
            web_mojibake_score(
                text
            )
        )

        cyrillic_count = len(
            re.findall(
                r"[А-Яа-яЁё]",
                text
            )
        )

        latin_count = len(
            re.findall(
                r"[A-Za-z]",
                text
            )
        )

        weird_count = len(
            re.findall(
                r"[╔╚╠╦╩╬╭╮╯╰╱╲╳"
                r"┐└┘├┤┬┴│─]",
                text
            )
        )

        score = (
            replacement_count * 5000
            + mojibake * 100
            + weird_count * 100
            - min(
                cyrillic_count,
                20000
            ) * 2
            - min(
                latin_count,
                5000
            ) * 0.05
        )

        if (
            best_score is None
            or score < best_score
        ):

            best_score = score
            best_text = text
            best_encoding = encoding

    if not best_text:
        return ""

    print(
        f"[WEB ENCODING] "
        f"selected={best_encoding} "
        f"score={best_score}"
    )

    # --------------------------------------------------------
    # Финальный repair.
    # --------------------------------------------------------

    best_text = repair_web_mojibake(
        best_text
    )

   


# ============================================================
# WEB EXCERPT
# ============================================================

def web_excerpt(
    text,
    query,
    max_chars=1200
):

    text = clean_web_text(
        text
    )

    if not text:
        return ""

    # Финальная попытка исправить mojibake.
    text = repair_web_mojibake(
        text
    )

    if not text:
        return ""

    sentences = re.split(
        r"(?<=[.!?])\s+",
        text
    )

    query_tokens = [
        token
        for token in web_tokens(
            query
        )
        if len(token) >= 3
    ]

    stop_words = {
        "какой",
        "какая",
        "какое",
        "какие",
        "какого",
        "года",
        "год",
        "годы",
        "выпуска",
        "выпускается",
        "выпускался",
        "выпускались",
        "выпуск",
        "с",
        "до",
        "для",
        "это",
        "the",
        "what",
        "when",
        "year",
        "years",
        "production",
        "model",
        "models",
    }

    useful_tokens = [
        token
        for token in query_tokens
        if token not in stop_words
    ]

    query_lower = safe_text(
        query
    ).lower()

    scored = []

    for position, sentence in enumerate(
        sentences
    ):

        sentence_lower = (
            sentence.lower()
        )

        score = 0

        for token in useful_tokens:

            if token in sentence_lower:

                score += 5

        if (
            query_lower
            and query_lower in sentence_lower
        ):

            score += 20

        # Очень важны годы.
        if re.search(
            r"\b(?:19|20)\d{2}\b",
            sentence
        ):

            score += 5

        # Для вопросов о производстве
        # особенно полезны эти слова.
        for phrase in (
            "производ",
            "выпуск",
            "годы выпуска",
            "год выпуска",
            "production",
            "production years",
            "model year",
            "introduced",
            "debut",
            "built",
            "from",
            "until",
        ):

            if phrase in sentence_lower:

                score += 3

        if score > 0:

            scored.append(
                (
                    score,
                    position,
                    sentence
                )
            )

    if scored:

        scored.sort(
            key=lambda item: item[0],
            reverse=True
        )

        _, best_position, _ = scored[0]

        selected = []

        for position in (
            best_position - 1,
            best_position,
            best_position + 1
        ):

            if (
                position < 0
                or position >= len(sentences)
            ):
                continue

            sentence = safe_text(
                sentences[position]
            )

            if not sentence:
                continue

            if sentence not in selected:

                selected.append(
                    sentence
                )

        result = " ".join(
            selected
        )

        result = clean_web_text(
            result
        )

        result = repair_web_mojibake(
            result
        )

        if len(result) > max_chars:

            result = (
                result[
                    :max_chars - 3
                ]
                + "..."
            )

        return result

    if len(text) > max_chars:

        return (
            text[
                :max_chars - 3
            ]
            + "..."
        )

    return text


# ============================================================
# WEB PAGE EXTRACTION
# ============================================================

def extract_web_page(
    url,
    query
):

    if not url:
        return ""

    try:

        print(
            f"[WEB PAGE] GET: {url}"
        )

        response = requests.get(
            url,
            headers={
                **USER_AGENT,
                "Accept": (
                    "text/html,"
                    "application/xhtml+xml,"
                    "application/xml;q=0.9,"
                    "*/*;q=0.8"
                ),
                "Accept-Language": (
                    "ru-RU,ru;q=0.9,"
                    "de-DE,de;q=0.8,"
                    "en;q=0.7"
                ),
            },
            timeout=WEB_EXTRACT_TIMEOUT,
            allow_redirects=True
        )

        if response.status_code != 200:

            print(
                f"[WEB PAGE] HTTP "
                f"{response.status_code}: "
                f"{url}"
            )

            return ""

        content_type = (
            response.headers.get(
                "Content-Type",
                ""
            ).lower()
        )

        # Иногда сервер не указывает Content-Type.
        # В таком случае всё равно пробуем HTML,
        # если URL явно похож на страницу.
        if (
            "text/html" not in content_type
            and "application/xhtml" not in content_type
            and content_type
        ):

            return ""

        # ----------------------------------------------------
        # ПРАВИЛЬНО ДЕКОДИРУЕМ RESPONSE
        # ----------------------------------------------------

        html = decode_web_response(
            response
        )

        if not html:

            return ""

        # ----------------------------------------------------
        # Проверка кодировки.
        # ----------------------------------------------------

        if "\ufffd" in html:

            replacement_count = html.count(
                "\ufffd"
            )

            print(
                f"[WEB PAGE] Warning: "
                f"{replacement_count} "
                f"replacement chars"
            )

            html = html.replace(
                "\ufffd",
                " "
            )

        # ----------------------------------------------------
        # Финальный repair HTML.
        # ----------------------------------------------------

        html = repair_web_mojibake(
            html
        )

        # ----------------------------------------------------
        # HTML -> text
        # ----------------------------------------------------

        soup = BeautifulSoup(
            html,
            "html.parser"
        )

        # ----------------------------------------------------
        # Удаляем мусор.
        # ----------------------------------------------------

        for tag in soup([
            "script",
            "style",
            "noscript",
            "svg",
            "canvas",
            "iframe",
            "form",
            "nav",
            "footer",
            "header",
            "aside"
        ]):

            tag.decompose()

        # ----------------------------------------------------
        # Сначала пытаемся взять основной контент.
        # ----------------------------------------------------

        content_node = None

        for selector in (
            "main",
            "article",
            "[role='main']",
            ".content",
            ".article",
            ".post",
        ):

            try:

                content_node = soup.select_one(
                    selector
                )

            except Exception:

                content_node = None

            if content_node:
                break

        if content_node:

            text = content_node.get_text(
                " ",
                strip=True
            )

        else:

            text = soup.get_text(
                " ",
                strip=True
            )

        # ----------------------------------------------------
        # Очистка.
        # ----------------------------------------------------

        text = clean_web_text(
            text
        )

        if not text:

            return ""

        # ----------------------------------------------------
        # Исправляем mojibake уже после
        # извлечения текста.
        # ----------------------------------------------------

        text = repair_web_mojibake(
            text
        )

        text = clean_web_text(
            text
        )

        if not text:

            return ""

        # ----------------------------------------------------
        # Ищем полезный фрагмент.
        # ----------------------------------------------------

        excerpt = web_excerpt(
            text,
            query,
            max_chars=1200
        )

        if excerpt:

            return excerpt

        return text[:1200]

    except Exception as e:

        print(
            f"[WEB PAGE] ERROR: "
            f"{url} -> {e}"
        )

        return ""

# ============================================================
# WEB SEARCH
# ============================================================

def web_search(
    query,
    max_results=WEB_MAX_RESULTS
):

    query = safe_text(
        query
    )

    if not query:
        return []

    cache_key = (
        "v2:"
        + query.lower().strip()
    )

    # --------------------------------------------------------
    # CACHE
    # --------------------------------------------------------

    with web_cache_lock:

        cached = web_cache.get(
            cache_key
        )

        if cached:

            created = cached.get(
                "created",
                0
            )

            if (
                time.time() - created
                < WEB_CACHE_TTL
            ):

                print(
                    f"[WEB CACHE] HIT: "
                    f"{query}"
                )

                return [
                    dict(item)
                    for item in cached.get(
                        "results",
                        []
                    )
                ]

            web_cache.pop(
                cache_key,
                None
            )

    print(
        f"[WEB SEARCH] {query}"
    )

    regions = (
        web_region_candidates(
            query
        )
    )

    raw_results = []

    # --------------------------------------------------------
    # SEARCH
    # --------------------------------------------------------

    for region in regions:

        try:

            print(
                f"[WEB SEARCH] "
                f"region={region}"
            )

            from ddgs import DDGS

            ddgs = DDGS(
                timeout=WEB_SEARCH_TIMEOUT
            )

            found = ddgs.text(
                query,
                region=region,
                safesearch="moderate",
                max_results=WEB_RAW_RESULTS,
                backend="auto"
            )

            if found:

                raw_results.extend(
                    found
                )

            # Если уже набрали достаточно —
            # второй регион не нужен.
            if len(raw_results) >= (
                max_results * 2
            ):

                break

        except Exception as e:

            print(
                f"[WEB SEARCH] "
                f"region={region} "
                f"ERROR: {e}"
            )

            continue

    if not raw_results:

        print(
            "[WEB SEARCH] "
            "No raw results"
        )

        return []

    # --------------------------------------------------------
    # DEDUPLICATION + RANKING
    # --------------------------------------------------------

    unique = {}

    for item in raw_results:

        url = safe_text(
            item.get("href")
            or item.get("url")
        )

        if not url:
            continue

        canonical = (
            canonical_web_url(
                url
            )
        )

        if not canonical:
            continue

        title = clean_web_text(
            item.get(
                "title",
                ""
            )
        )

        body = clean_web_text(
            item.get(
                "body",
                ""
            )
        )

        candidate = {
            "title": (
                title
                or "Страница без названия"
            ),
            "url": url,
            "body": body,
            "_score": web_result_score(
                item,
                query
            )
        }

        # Если один URL пришёл
        # из нескольких источников —
        # оставляем лучший вариант.
        if canonical not in unique:

            unique[
                canonical
            ] = candidate

        else:

            old = unique[
                canonical
            ]

            if (
                candidate["_score"]
                > old["_score"]
            ):

                unique[
                    canonical
                ] = candidate

    results = list(
        unique.values()
    )

    # --------------------------------------------------------
    # Сортировка по релевантности.
    # --------------------------------------------------------

    results.sort(
        key=lambda item:
            item.get(
                "_score",
                0
            ),
        reverse=True
    )

    # --------------------------------------------------------
    # Не даём одному домену
    # полностью заполнить выдачу.
    # --------------------------------------------------------

    final_results = []

    domains_count = defaultdict(
        int
    )

    for item in results:

        domain = web_domain(
            item.get(
                "url",
                ""
            )
        )

        # Максимум 3 результата
        # с одного домена.
        if (
            domains_count[domain]
            >= 3
        ):
            continue

        domains_count[
            domain
        ] += 1

        final_results.append(
            item
        )

        if len(final_results) >= (
            max_results
        ):
            break

    # --------------------------------------------------------
    # EXTRACT TOP PAGES
    # --------------------------------------------------------

    extract_targets = (
        final_results[
            :WEB_EXTRACT_COUNT
        ]
    )

    if extract_targets:

        with ThreadPoolExecutor(
            max_workers=WEB_EXTRACT_WORKERS
        ) as executor:

            futures = {
                executor.submit(
                    extract_web_page,
                    item.get(
                        "url",
                        ""
                    ),
                    query
                ): item
                for item in extract_targets
            }

            for future in as_completed(
                futures
            ):

                item = futures[
                    future
                ]

                try:

                    excerpt = (
                        future.result()
                    )

                    if excerpt:

                        item[
                            "excerpt"
                        ] = excerpt

                except Exception as e:

                    print(
                        f"[WEB EXTRACT WORKER] "
                        f"{e}"
                    )

    # --------------------------------------------------------
    # Удаляем внутренний score.
    # --------------------------------------------------------

    for item in final_results:

        item.pop(
            "_score",
            None
        )

    # --------------------------------------------------------
    # CACHE SAVE
    # --------------------------------------------------------

    with web_cache_lock:

        web_cache[
            cache_key
        ] = {
            "created": time.time(),
            "results": [
                dict(item)
                for item in final_results
            ]
        }

        # Простейшая очистка старого cache.
        if len(web_cache) > (
            WEB_CACHE_MAX_ITEMS
        ):

            oldest_key = min(
                web_cache,
                key=lambda key:
                    web_cache[key].get(
                        "created",
                        0
                    )
            )

            web_cache.pop(
                oldest_key,
                None
            )

    print(
        f"[WEB SEARCH] "
        f"Final results: "
        f"{len(final_results)}"
    )

    return final_results


def normalize(text):
    """
    Нормализация для поиска.
    """

    text = safe_text(text).lower()

    # Кириллица -> латиница
    replacements = {
        "а": "a",
        "в": "b",
        "с": "c",
        "е": "e",
        "н": "h",
        "к": "k",
        "м": "m",
        "о": "o",
        "р": "p",
        "т": "t",
        "х": "x",
        "у": "y",
    }

    for old, new in replacements.items():
        text = text.replace(old, new)

    text = re.sub(
        r"[\s\-_./\\]+",
        "",
        text
    )

    return text


def fix_a(text):
    return safe_text(text).lower().replace(
        "а",
        "a"
    )


def first_photo(value):
    if not value:
        return None

    for photo in str(value).split(","):

        photo = photo.strip()

        if (
            photo.startswith("http://")
            or photo.startswith("https://")
        ):
