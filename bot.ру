@bot.message_handler(
    content_types=["text"]
)
def handle_text(message):
    chat_id = message.chat.id

    text = safe_text(
        message.text
    )

    print(
        f"[TEXT] {chat_id}: {text}"
    )

    # --------------------------------------------------------
    # Главное меню.
    # --------------------------------------------------------

    if text == "🚗 Найти запчасть":
        enter_parts_mode(
            chat_id
        )

        return

    if text == "🛞 Шины и диски":
        enter_wheels_mode(
            chat_id
        )

        return

    if text == "🤖 Спросить у ИИ":
        enter_ai_mode(
            chat_id
        )

        return

    if text == "🚘 В разборе":
        enter_donors_mode(
            chat_id
        )

        return

    if text == "❤️ Избранное":
        show_favorites(
            chat_id
        )

        return

    # --------------------------------------------------------
    # Команды.
    # --------------------------------------------------------

    if text.startswith("/"):
        return

    # --------------------------------------------------------
    # AI / WEB.
    # --------------------------------------------------------

    if current_mode.get(
        chat_id
    ) == "ai":
        ask_ai_web(
            chat_id,
            text
        )

        return

    # --------------------------------------------------------
    # Обычный поиск.
    # --------------------------------------------------------

    perform_search(
        chat_id,
        text
    )


