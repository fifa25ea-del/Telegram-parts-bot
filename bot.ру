# CACHE INFO
# ============================================================

@bot.message_handler(
    commands=["cache"]
)
def cache_cmd(
    message
):

    if (
        message.from_user.id
        != ADMIN_ID
    ):

        return

    ensure_cache_dir()

    try:

        files = [
            filename
            for filename in os.listdir(
                PHOTO_CACHE_DIR
            )
            if os.path.isfile(
                os.path.join(
                    PHOTO_CACHE_DIR,
                    filename
                )
            )
        ]

        total_size = 0

        for filename in files:

            path = os.path.join(
                PHOTO_CACHE_DIR,
                filename
            )

            try:

                total_size += os.path.getsize(
                    path
                )

            except Exception:
                pass

        mb = (
            total_size
            / 1024
            / 1024
        )

        bot.send_message(
            message.chat.id,
            (
                "📸 Фото-кэш\n\n"
                f"Файлов: {len(files)}\n"
                f"Размер: {mb:.2f} MB"
            )
        )

    except Exception as e:

        bot.send_message(
            message.chat.id,
            f"❌ Ошибка кэша: {e}"
        )


