def get_item_id(
    item,
    fallback=""
):

    article = get_field(
        item,
        "Артикул",
        "артикул",
        "article"
    )

    if article:
        return article

    number = get_field(
        item,
        "Номер",
        "номер"
    )

    if number:
        return number

    # Для дисков может пригодиться
    # комбинация производителя/модели.
    brand = get_field(
        item,
        "Производитель диска"
    )

    model = get_field(
        item,
        "Модель диска"
    )

    if brand or model:

        generated = (
            f"{brand}|{model}"
        )

        if generated.strip("|"):

            return generated

    return fallback


