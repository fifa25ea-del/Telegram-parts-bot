def find_part(
    query,
    db=None
):

    query = normalize(
        query
    )

    if not query:
        return []

    with database_lock:

        database = (
            parts_db
            if db is None
            else db
        )

        # Быстрый индекс.
        positions = []

        if query in parts_index:

            positions = parts_index[
                query
            ]

        elif len(query) >= 4:

            prefix = query[:4]

            positions = parts_index.get(
                prefix,
                []
            )

        # Если индекс ничего не дал,
        # делаем ограниченный fallback.
        if positions:

            unique_positions = []

            seen = set()

            for position in positions:

                if position in seen:
                    continue

                seen.add(
                    position
                )

                unique_positions.append(
                    position
                )

                if (
                    len(unique_positions)
                    >= MAX_RESULTS
                ):
                    break

            results = [
                database[position]
                for position
                in unique_positions
                if position < len(database)
            ]

            # Проверяем совпадение.
            final = []

            for part in results:

                values = []

                if number_key:

                    values.append(
                        part.get(
                            number_key,
                            ""
                        )
                    )

                values.extend([
                    part.get(
                        "Артикул",
                        ""
                    ),
                    part.get(
                        "Номер",
                        ""
                    )
                ])

                if any(
                    query in normalize(
                        fix_a(value)
                    )
                    for value in values
                    if value
                ):

                    final.append(
                        part
                    )

            return final[
                :MAX_RESULTS
            ]

        # Fallback для старых/неожиданных
        # форматов CSV.
        results = []

        for part in database:

            values = []

            if number_key:

                values.append(
                    part.get(
                        number_key,
                        ""
                    )
                )

            values.extend([
                part.get(
                    "Артикул",
                    ""
                ),
                part.get(
                    "Номер",
                    ""
                )
            ])

            for value in values:

                normalized = normalize(
                    fix_a(value)
                )

                if (
                    query
                    and query in normalized
                ):

                    results.append(
                        part
                    )

                    break

            if len(results) >= MAX_RESULTS:
                break

        return results


