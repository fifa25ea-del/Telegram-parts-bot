@bot.callback_query_handler(
    func=lambda call:
        call.data.startswith(
            "photo_"
        )
)
def photo_navigation(call):

    chat_id = call.message.chat.id

    results = user_results.get(
        chat_id,
        []
    )

    if not results:

        bot.answer_callback_query(
            call.id,
            "Нет данных"
        )

        return

    current = user_index.get(
        chat_id,
        0
    )

    if current >= len(results):
        current = 0

    part = results[current]

    photos = get_photo_list(
        part.get("Фото")
        or part.get("photo")
        or ""
    )

    if not photos:

        bot.answer_callback_query(
            call.id,
            "Нет фото"
        )

        return

    photo_index = user_photo_index.get(
        chat_id,
        0
    )

    if "next" in call.data:

        photo_index += 1

    else:

        photo_index -= 1

    if photo_index < 0:

        photo_index = len(photos) - 1

    if photo_index >= len(photos):

        photo_index = 0

    user_photo_index[chat_id] = (
        photo_index
    )

    new_photo = photos[
        photo_index
    ]

    try:

        caption = (
            call.message.caption
            or ""
        )

        media = types.InputMediaPhoto(
            new_photo,
            caption=caption
        )

        bot.edit_message_media(
            media=media,
            chat_id=chat_id,
            message_id=call.message.message_id,
            reply_markup=call.message.reply_markup
        )

        bot.answer_callback_query(
            call.id
        )

    except Exception as e:

        print(
            "Ошибка переключения фото:",
            e
        )

        bot.answer_callback_query(
            call.id,
            "Ошибка фото"
        )


