def perform_search(
    chat_id,
    query
):

    query = safe_text(
        query
    )

    if len(query) < 2:

        bot.send_message(
            chat_id,
            "⚠️ Введите минимум 2 символа."
        )

        return

    mode = current_mode.get(
        chat_id
    )

    if mode == "parts":

        print(
            f"🔥 SEARCH PARTS: {query}"
        )

        log_search(
            chat_id,
            query,
            "parts"
        )

        results = find_part(
            query
        )

        if not results:

            print(
                f"❌ NOT FOUND PARTS: "
                f"{query}"
            )

            log_search(
                chat_id,
                query,
                "NOT_FOUND"
            )

            bot.send_message(
                chat_id,
                (
                    "❌ Ничего не найдено.\n\n"
                    "Проверьте номер детали "
                    "или попробуйте другой вариант."
                )
            )

            return

        user_results[chat_id] = results
        user_index[chat_id] = 0
        user_photo_index[chat_id] = 0

        send_part_card(
            chat_id,
            0
        )

        return

    if mode == "wheels":

        print(
            f"🔥 SEARCH WHEELS: {query}"
        )

        log_search(
            chat_id,
            query,
            "wheels"
        )

        results = find_wheels(
            query
        )

        if not results:

            print(
                f"❌ NOT FOUND WHEELS: "
                f"{query}"
            )

            log_search(
                chat_id,
                query,
                "NOT_FOUND_WHEELS"
            )

            bot.send_message(
                chat_id,
                "❌ Ничего не найдено."
            )

            return

        user_results[chat_id] = results
        user_index[chat_id] = 0
        user_photo_index[chat_id] = 0

        send_wheels_preview(
            chat_id,
            results
        )

        return

    if mode == "donors":

        bot.send_message(
            chat_id,
            (
                "🚘 Вы находитесь в разделе "
                "«В разборе».\n\n"
                "Для поиска конкретной запчасти "
                "выберите «🚗 Найти запчасть»."
            )
        )

        return

    if mode == "favorites":

        bot.send_message(
            chat_id,
            (
                "❤️ Сейчас открыт раздел "
                "избранного.\n\n"
                "Выберите другой раздел "
                "для поиска."
            )
        )

        return

    bot.send_message(
        chat_id,
        "Выберите раздел из меню.",
        reply_markup=main_menu()
    )


