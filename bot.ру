def find_wheels(
    query
):

    original = safe_text(
        query
    )

    q = normalize_search(
        original
    )

    if not q:
        return []

    radius_q = q

    if radius_q.startswith(
        "r"
    ):

        radius_q = radius_q[1:]

    candidate_indexes = set()

    with database_lock:

        # ----------------------------------------------------
        # Радиус
        # ----------------------------------------------------

        if radius_q:

            for idx in wheels_radius_index.get(
                radius_q,
                []
            ):

                candidate_indexes.add(
                    idx
                )

        # ----------------------------------------------------
        # Артикул
        # ----------------------------------------------------

        for idx in wheels_article_index.get(
            q,
            []
        ):

            candidate_indexes.add(
                idx
            )

        # ----------------------------------------------------
        # Бренд
        # ----------------------------------------------------

        for key, indexes in (
            wheels_brand_index.items()
        ):

            if (
                q in key
                or key in q
            ):

                candidate_indexes.update(
                    indexes
                )

                if (
                    len(candidate_indexes)
                    >= MAX_RESULTS
                ):

                    break

        # ----------------------------------------------------
        # Модель
        # ----------------------------------------------------

        if len(candidate_indexes) < MAX_RESULTS:

            for key, indexes in (
                wheels_model_index.items()
            ):

                if (
                    q in key
                    or key in q
                ):

                    candidate_indexes.update(
                        indexes
                    )

                    if (
                        len(candidate_indexes)
                        >= MAX_RESULTS
                    ):

                        break

        # ----------------------------------------------------
        # Fallback
        # ----------------------------------------------------

        if not candidate_indexes:

            for i, item in enumerate(
                wheels_db
            ):

                radius = normalize_search(
                    get_field(
                        item,
                        "Диаметр диска",
                        "Диаметр"
                    )
                )

                if radius.startswith("r"):

                    radius = radius[1:]

                brand = normalize_search(
                    get_field(
                        item,
                        "Производитель диска",
                        "Производитель",
                        "Бренд"
                    )
                )

                model = normalize_search(
                    get_field(
                        item,
                        "Модель диска",
                        "Модель"
                    )
                )

                article = normalize_search(
                    get_field(
                        item,
                        "Артикул"
                    )
                )

                if (
                    q == radius
                    or q in brand
                    or q in model
                    or q in article
                ):

                    candidate_indexes.add(
                        i
                    )

                if (
                    len(candidate_indexes)
                    >= MAX_RESULTS
                ):

                    break

        result = []

        for idx in sorted(
            candidate_indexes
        ):

            if idx < 0:
                continue

            if idx >= len(wheels_db):
                continue

            result.append(
                wheels_db[idx]
            )

            if len(result) >= MAX_RESULTS:
                break

        return result


