def get_item_id(item, fallback=""):
    """
    Стабильный ID товара.

    Важно: если в базе есть одинаковые артикулы,
    желательно использовать уникальный ID из CSV.
    """

    for key in (
        "ID",
        "id",
        "Ид",
        "Артикул",
        "Номер"
    ):
        value = safe_text(item.get(key))

        if value:
            return value

    # Последний fallback — хеш содержимого.
    if item:
        raw = json.dumps(
            item,
            ensure_ascii=False,
            sort_keys=True
        )

        return hashlib.sha1(
            raw.encode("utf-8")
        ).hexdigest()[:24]

    return fallback


def is_favorite(chat_id, item):
    user_id = str(chat_id)
    item_id = get_item_id(item)

    with favorites_lock:
        return item_id in favorites.get(user_id, [])


def add_favorite(chat_id, item):
    user_id = str(chat_id)
    item_id = get_item_id(item)

    if not item_id:
        return False

    with favorites_lock:

        favorites.setdefault(user_id, [])

        if item_id in favorites[user_id]:
            return False

        favorites[user_id].append(item_id)

        save_json_file(FAV_FILE, favorites)

    track(chat_id, "favorites")

    return True


def remove_favorite(chat_id, item_id):
    user_id = str(chat_id)

    with favorites_lock:

        if user_id not in favorites:
            return False

        if item_id not in favorites[user_id]:
            return False

        favorites[user_id].remove(item_id)

        save_json_file(FAV_FILE, favorites)

    return True


def find_favorite_items(chat_id):
    user_id = str(chat_id)

    with favorites_lock:
        ids = set(favorites.get(user_id, []))

    if not ids:
        return []

    result = []

    with database_lock:

        for item in parts_db:
            if get_item_id(item) in ids:
                result.append(("parts", item))

        for item in wheels_db:
            if get_item_id(item) in ids:
                result.append(("wheels", item))

    return result


