# ПОЛУЧЕНИЕ ЗНАЧЕНИЙ
# ============================================================

def get_field(
    item,
    *names
):

    if not item:
        return ""

    # Точное совпадение.
    for name in names:

        value = item.get(
            name
        )

        if value not in (
            None,
            ""
        ):

            return safe_text(
                value
            )

    # Нормализованное совпадение.
    normalized_names = {
        normalize(name)
        for name in names
    }

    for key, value in item.items():

        if normalize(key) in normalized_names:

            if value not in (
                None,
                ""
            ):

                return safe_text(
                    value
                )

    return ""


