def atomic_json_save(
    filename,
    data
):

    try:

        temp_file = (
            filename + ".tmp"
        )

        with open(
            temp_file,
            "w",
            encoding="utf-8"
        ) as f:

            json.dump(
                data,
                f,
                ensure_ascii=False,
                indent=2
            )

        os.replace(
            temp_file,
            filename
        )

    except Exception as e:

        print(
            f"[JSON] Ошибка {filename}: {e}"
        )


