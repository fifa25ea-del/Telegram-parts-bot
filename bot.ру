def find_part(
    query
):

    normalized_query = normalize_search(
        query
    )

    if not normalized_query:
        return []

    candidate_indexes = set()

    with database_lock:

        # ----------------------------------------------------
        # 1. Быстрый индекс — точное совпадение
        # ----------------------------------------------------

        for idx in parts_article_index.get(
            normalized_query,
            []
        ):

            candidate_indexes.add(
                idx
            )

        for idx in parts_number_index.get(
            normalized_query,
            []
        ):

            candidate_indexes.add(
                idx
            )

        # ----------------------------------------------------
        # 2. Если точного совпадения нет,
        # ищем по ключам индекса.
        # Это всё равно значительно дешевле,
        # чем перебирать всю строку базы.
        # ----------------------------------------------------

        if not candidate_indexes:

            for key, indexes in (
                parts_article_index.items()
            ):

                if (
                    normalized_query in key
                    or key in normalized_query
                ):

                    candidate_indexes.update(
                        indexes
                    )

                    if (
                        len(candidate_indexes)
                        >= MAX_RESULTS
                    ):

                        break

        if len(candidate_indexes) < MAX_RESULTS:

            for key, indexes in (
                parts_number_index.items()
            ):

                if (
                    normalized_query in key
                    or key in normalized_query
                ):

                    candidate_indexes.update(
                        indexes
                    )

                    if (
                        len(candidate_indexes)
                        >= MAX_RESULTS
                    ):

                        break

        # ----------------------------------------------------
        # Если индекс ничего не дал —
        # fallback по нескольким полям.
        # ----------------------------------------------------

        if not candidate_indexes:

            for i, item in enumerate(
                parts_db
            ):

                values = []

                if number_key:

                    values.append(
                        item.get(
                            number_key,
                            ""
                        )
                    )

                values.extend([
                    item.get(
                        "Артикул",
                        ""
                    ),
                    item.get(
                        "Номер",
                        ""
                    )
                ])

                found = False

                for value in values:

                    normalized_value = (
                        normalize_search(
                            value
                        )
                    )

                    if (
                        normalized_query
                        in normalized_value
                    ):

                        found = True
                        break

                if found:

                    candidate_indexes.add(
                        i
                    )

                if (
                    len(candidate_indexes)
                    >= MAX_RESULTS
                ):

                    break

        result = []

        for idx in sorted(
            candidate_indexes
        ):

            if idx < 0:
                continue

            if idx >= len(parts_db):
                continue

            result.append(
                parts_db[idx]
            )

            if len(result) >= MAX_RESULTS:
                break

        return result


