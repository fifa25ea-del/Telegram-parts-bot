def find_part(query):
    query = normalize(
        fix_a(query)
    )

    if not query:
        return []

    with database_lock:
        positions = []

        # ----------------------------------------------------
        # Быстрый поиск по индексу.
        # ----------------------------------------------------

        if query in parts_index:
            positions = parts_index[
                query
            ]

        elif len(query) >= 4:
            positions = parts_index.get(
                query[:4],
                []
            )

        results = []
        seen = set()

        for position in positions:
            if position in seen:
                continue

            seen.add(position)

            if position >= len(parts_db):
                continue

            part = parts_db[
                position
            ]

            values = []

            if cross_numbers_key:
                values.append(
                    part.get(
                        cross_numbers_key,
                        ""
                    )
                )

            if manufacturer_number_key:
                values.append(
                    part.get(
                        manufacturer_number_key,
                        ""
                    )
                )

            found = False

            for value in values:
                numbers = re.split(
                    r"[,;/|\n]+",
                    safe_text(value)
                )

                for number in numbers:
                    number = normalize(
                        fix_a(number)
                    )

                    if query in number:
                        found = True
                        break

                if found:
                    break

            if found:
                results.append(part)

            if len(results) >= MAX_RESULTS:
                break

        if results:
            return results

        # ----------------------------------------------------
        # Полный fallback-поиск.
        # ----------------------------------------------------

        for part in parts_db:
            values = []

            if cross_numbers_key:
                values.append(
                    part.get(
                        cross_numbers_key,
                        ""
                    )
                )

            if manufacturer_number_key:
                values.append(
                    part.get(
                        manufacturer_number_key,
                        ""
                    )
                )

            found = False

            for value in values:
                numbers = re.split(
                    r"[,;/|\n]+",
                    safe_text(value)
                )

                for number in numbers:
                    number = normalize(
                        fix_a(number)
                    )

                    if query in number:
                        found = True
                        break

                if found:
                    break

            if found:
                results.append(part)

            if len(results) >= MAX_RESULTS:
                break

        return results


