def track(user_id, action):
    """
    action:
    searches
    views
    favorites
    """

    user_id = str(user_id)

    if user_id not in stats:
        stats[user_id] = {
            "searches": 0,
            "views": 0,
            "favorites": 0
        }

    if action not in stats[user_id]:
        stats[user_id][action] = 0

    stats[user_id][action] += 1

    save_stats()


