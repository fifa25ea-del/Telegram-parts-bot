# ============================================================

def download_photos_parallel(
    urls
):

    unique_urls = []

    seen = set()

    for url in urls:

        if not url:
            continue

        if url in seen:
            continue

        seen.add(url)

        unique_urls.append(
            url
        )

    if not unique_urls:
        return []

    results = {}

    # Сначала берём то, что уже есть
    # в кэше.
    missing = []

    for url in unique_urls:

        cached = get_cached_photo(
            url
        )

        if cached:

            results[url] = cached

        else:

            missing.append(
                url
            )

    if missing:

        with ThreadPoolExecutor(
            max_workers=PHOTO_WORKERS
        ) as executor:

            futures = {
                executor.submit(
                    download_photo,
                    url
                ): url
                for url in missing
            }

            for future in as_completed(
                futures
            ):

                url = futures[
                    future
                ]

                try:

                    content = future.result()

                    if content:

                        results[url] = content

                except Exception as e:

                    print(
                        f"[PHOTO] Worker error: "
                        f"{e}"
                    )

    return [
        results[url]
        for url in unique_urls
        if url in results
    ]


