@bot.callback_query_handler(
    func=lambda call: True
)
def callback(call):

    data = call.data

    chat_id = call.message.chat.id

    results = user_results.get(
        chat_id,
        []
    )

    # ========================================================
    # ИЗБРАННОЕ
    # ========================================================

    if data.startswith("fav_"):

        try:

            index = int(
                data.split("_")[1]
            )

        except Exception:

            return

        if (
            not results
            or index < 0
            or index >= len(results)
        ):

            return

        item = results[index]

        user_id = str(
            chat_id
        )

        item_id = (
            item.get("Артикул")
            or str(index)
        )

        if user_id not in favorites:

            favorites[user_id] = []

        if item_id in favorites[user_id]:

            try:

                bot.answer_callback_query(
                    call.id,
                    "Уже в избранном"
                )

            except Exception:
                pass

        else:

            favorites[user_id].append(
                item_id
            )

            save_favorites(
                favorites
            )

            # Исправлено:
            # раньше здесь ошибочно считались searches
            track(
                chat_id,
                "favorites"
            )

            try:

                bot.answer_callback_query(
                    call.id,
                    "❤️ Добавлено"
                )

            except Exception:
                pass

        return


    # ========================================================
    # ФОТО ДОНОРА
    # ========================================================

    if data.startswith(
        "donor_photos_"
    ):

        try:

            index = int(
                data.split("_")[-1]
            )

        except Exception:

            return

        if (
            not results
            or index < 0
            or index >= len(results)
        ):

            return

        donor = results[index]

        photos = str(
            donor.get(
                "Фото",
                ""
            )
        )

        photo_list = [
            x.strip()
            for x in photos.split(",")
            if x.strip().startswith("http")
        ]

        if not photo_list:

            try:

                bot.answer_callback_query(
                    call.id,
                    "❌ Нет фото"
                )

            except Exception:
                pass

            return

        try:

            bot.answer_callback_query(
                call.id
            )

        except Exception:
            pass

        media = []

        for i, url in enumerate(
            photo_list[:10]
        ):

            if i == 0:

                media.append(
                    telebot.types.InputMediaPhoto(
                        url,
                        caption="📸 Фото донора"
                    )
                )

            else:

                media.append(
                    telebot.types.InputMediaPhoto(
                        url
                    )
                )

        try:

            bot.send_media_group(
                chat_id,
                media
            )

        except Exception as e:

            print(
                "Ошибка альбома донора:",
                e
            )

        return


    # ========================================================
    # ПЕРЕКЛЮЧЕНИЕ КАРТОЧЕК
    # ========================================================

    if (
        data.startswith("next_")
        or data.startswith("prev_")
    ):

        if not results:

            try:

                bot.answer_callback_query(
                    call.id,
                    "Нет данных"
                )

            except Exception:
                pass

            return

        current = user_index.get(
            chat_id,
            0
        )

        if data.startswith("next_"):

            current += 1

        else:

            current -= 1

        if current < 0:

            current = (
                len(results) - 1
            )

        if current >= len(results):

            current = 0

        user_index[
            chat_id
        ] = current

        user_photo_index[
            chat_id
        ] = 0

        mode = current_mode.get(
            chat_id,
            "parts"
        )

        try:

            bot.answer_callback_query(
                call.id
            )

        except Exception:
            pass


        # ====================================================
        # КОЛЁСА
        # ====================================================

        if mode == "wheels":

            # Просто удаляем старую карточку
            # и создаём новую.
            try:

                bot.delete_message(
                    chat_id,
                    call.message.message_id
                )

            except Exception:
                pass

            send_wheel_card(
                chat_id,
                current
            )

            return


        # ====================================================
        # ДОНОРЫ
        # ====================================================

        if mode == "donors":

            try:

                bot.delete_message(
                    chat_id,
                    call.message.message_id
                )

            except Exception:
                pass

            send_donor_card(
                chat_id,
                current
            )

            return


        # ====================================================
        # ЗАПЧАСТИ
        # ====================================================

        old_msgs = user_last_msg.get(
            chat_id,
            []
        )

        if not isinstance(
            old_msgs,
            list
        ):

            old_msgs = [
                old_msgs
            ]

        for msg_id in old_msgs:

            try:

                bot.delete_message(
                    chat_id,
                    msg_id
                )

            except Exception:
                pass

        send_part_card(
            chat_id,
            current
        )

        return


    # ========================================================
    # СТАРЫЙ ФОРМАТ CARD
    # ========================================================

    if data.startswith("card_"):

        try:

            index = int(
                data.split("_")[1]
            )

            send_card(
                chat_id,
                index
            )

        except Exception:
            pass

        return


