def find_wheels(query, db):

    query_normalized = (
        str(query)
        .lower()
        .replace(" ", "")
        .replace("-", "")
        .strip()
    )

    if not query_normalized:
        return []

    results = []

    for part in db:

        radius = (
            str(
                part.get(
                    "Диаметр диска",
                    ""
                )
            )
            .lower()
            .replace(" ", "")
            .replace("-", "")
        )

        brand = (
            str(
                part.get(
                    "Производитель диска",
                    ""
                )
            )
            .lower()
        )

        model = (
            str(
                part.get(
                    "Модель диска",
                    ""
                )
            )
            .lower()
        )

        # Убираем R для поиска
        query_without_r = query_normalized

        if query_without_r.startswith("r"):
            query_without_r = query_without_r[1:]

        # Поиск по радиусу
        radius_match = (
            query_without_r in radius
            or query_normalized in radius
            or query_without_r in f"r{radius}"
        )

        # Поиск по бренду
        brand_match = (
            query_normalized in brand
        )

        # Поиск по модели
        model_match = (
            query_normalized in model
        )

        if (
            radius_match
            or brand_match
            or model_match
        ):
            results.append(part)

        if len(results) >= MAX_RESULTS:
            break

    return results


