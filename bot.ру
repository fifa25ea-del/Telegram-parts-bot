# ============================================================

@bot.callback_query_handler(
    func=lambda call: (
        call.data.startswith(
            "next_"
        )
        or
        call.data.startswith(
            "prev_"
        )
    )
)
def callback_navigation(
    call
):

    safe_callback_answer(
        call
    )

    chat_id = call.message.chat.id

    # --------------------------------------------------------
    # Не допускаем одновременную навигацию
    # --------------------------------------------------------

    lock = user_locks[
        chat_id
    ]

    if not lock.acquire(
        blocking=False
    ):

        return

    try:

        results = user_results.get(
            chat_id,
            []
        )

        if not results:
            return

        current = user_index.get(
            chat_id,
            0
        )

        if call.data.startswith(
            "next_"
        ):

            current += 1

        else:

            current -= 1

        if current >= len(results):

            current = 0

        if current < 0:

            current = (
                len(results) - 1
            )

        user_index[chat_id] = (
            current
        )

        user_photo_index[chat_id] = 0

        # Удаляем альбом, если пользователь
        # листает дальше.
        delete_album(
            chat_id
        )

        mode = current_mode.get(
            chat_id
        )

        if mode == "parts":

            send_part_card(
                chat_id,
                current
            )

        elif mode == "wheels":

            send_wheel_card(
                chat_id,
                current
            )

        elif mode == "donors":

            send_donor_card(
                chat_id,
                current
            )

    except Exception as e:

        print(
            f"[NAVIGATION] Ошибка: {e}"
        )

    finally:

        lock.release()


