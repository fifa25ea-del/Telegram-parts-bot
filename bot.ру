        )

        return

    item = results[index]

    # --------------------------------------------------------
    # ВАЖНО:
    # отвечаем callback РОВНО ОДИН РАЗ.
    # --------------------------------------------------------

    if is_favorite(
        chat_id,
        item
    ):

        item_id = get_item_id(
